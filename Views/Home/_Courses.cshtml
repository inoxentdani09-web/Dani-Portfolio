<!-- =========================================================
     COURSES JAVASCRIPT
========================================================= -->

<script>

    /* =========================================================
       COURSE FILTER
    ========================================================= */

    function filterCourses(filter, button) {

        const cards =
            document.querySelectorAll(".course-card");

        const buttons =
            document.querySelectorAll(".course-filter-btn");


        /* Active button */

        buttons.forEach(function(btn) {

            btn.classList.remove("active");

        });


        if (button) {

            button.classList.add("active");

        }


        /* Filter cards */

        cards.forEach(function(card) {

            const priceType =
                card.getAttribute("data-price-type");

            const category =
                card.getAttribute("data-category");


            let showCard = false;


            if (filter === "all") {

                showCard = true;

            }
            else if (filter === "free") {

                showCard =
                    priceType === "free";

            }
            else if (filter === "paid") {

                showCard =
                    priceType === "paid";

            }
            else {

                showCard =
                    category === filter;

            }


            if (showCard) {

                card.style.display = "";

            }
            else {

                card.style.display = "none";

            }

        });

    }


    /* =========================================================
       FREE COURSE READER
    ========================================================= */

    function openFreeCourseReader(courseId) {

        const modal =
            document.getElementById(
                "freeCourseReaderModal"
            );


        if (!modal) {

            return;

        }


        modal.style.display = "flex";

        document.body.style.overflow = "hidden";


        const courseCard =
            document.getElementById(
                "course-card-" + courseId
            );


        if (courseCard) {

            const title =
                courseCard.querySelector("h3");


            const readerTitle =
                document.getElementById(
                    "readerCourseTitle"
                );


            if (title && readerTitle) {

                readerTitle.textContent =
                    title.textContent.trim();

            }

        }

    }


    function closeFreeCourseReader() {

        const modal =
            document.getElementById(
                "freeCourseReaderModal"
            );


        if (modal) {

            modal.style.display = "none";

        }


        document.body.style.overflow = "";

    }


    /* =========================================================
       PAID COURSE MODAL
    ========================================================= */

    function openCourseEnrollmentModal(courseId) {

        const modal =
            document.getElementById(
                "courseEnrollModal"
            );


        if (!modal) {

            return;

        }


        const hiddenId =
            document.getElementById(
                "checkoutCourseId"
            );


        if (hiddenId) {

            hiddenId.value = courseId;

        }


        const courseCard =
            document.getElementById(
                "course-card-" + courseId
            );


        if (courseCard) {

            const title =
                courseCard.querySelector("h3");


            const priceBadge =
                courseCard.querySelector(
                    ".course-pricing-badge.paid"
                );


            const originalPrice =
                courseCard.querySelector(
                    ".original-price"
                );


            const modalTitle =
                document.getElementById(
                    "checkoutCourseTitle"
                );


            const modalPrice =
                document.getElementById(
                    "checkoutCoursePrice"
                );


            const modalOriginal =
                document.getElementById(
                    "checkoutCourseOriginal"
                );


            if (title && modalTitle) {

                modalTitle.textContent =
                    title.textContent.trim();

            }


            if (priceBadge && modalPrice) {

                modalPrice.textContent =
                    priceBadge.textContent
                        .replace(" ", " ")
                        .trim();

            }


            if (originalPrice && modalOriginal) {

                modalOriginal.textContent =
                    originalPrice.textContent.trim();

            }

        }


        modal.style.display = "flex";

        document.body.style.overflow = "hidden";

    }


    function closeCourseEnrollModal() {

        const modal =
            document.getElementById(
                "courseEnrollModal"
            );


        if (modal) {

            modal.style.display = "none";

        }


        document.body.style.overflow = "";

    }


    /* =========================================================
       PAYMENT METHOD
    ========================================================= */

    function selectPaymentMethodTab(method) {

        const cards =
            document.querySelectorAll(
                ".payment-method-card"
            );


        cards.forEach(function(card) {

            card.classList.remove("active");

        });


        const radios =
            document.querySelectorAll(
                'input[name="paymentMethod"]'
            );


        radios.forEach(function(radio) {

            if (radio.value === method) {

                radio.checked = true;

                const parent =
                    radio.closest(
                        ".payment-method-card"
                    );

                if (parent) {

                    parent.classList.add("active");

                }

            }

        });


        const typeLabel =
            document.getElementById(
                "accTypeLabel"
            );


        if (typeLabel) {

            typeLabel.textContent =
                method.toUpperCase() + " ACCOUNT";

        }

    }


    /* =========================================================
       COPY PAYMENT NUMBER
    ========================================================= */

    function copyCurrentPaymentNumber() {

        const numberElement =
            document.getElementById(
                "accNumberVal"
            );


        if (!numberElement) {

            return;

        }


        const number =
            numberElement.textContent.trim();


        if (!number) {

            return;

        }


        if (navigator.clipboard) {

            navigator.clipboard.writeText(number)
                .then(function() {

                    alert("Account number copied.");

                })
                .catch(function() {

                    alert(number);

                });

        }
        else {

            alert(number);

        }

    }


    /* =========================================================
       SCREENSHOT PREVIEW
    ========================================================= */

    function handleProofScreenshotUpload(input) {

        const file =
            input.files && input.files[0];


        if (!file) {

            return;

        }


        const previewBox =
            document.getElementById(
                "screenshotPreviewBox"
            );


        const previewImage =
            document.getElementById(
                "screenshotPreviewImg"
            );


        if (!previewBox || !previewImage) {

            return;

        }


        const reader =
            new FileReader();


        reader.onload = function(event) {

            previewImage.src =
                event.target.result;


            previewBox.style.display =
                "block";

        };


        reader.readAsDataURL(file);

    }


    /* =========================================================
       COPY READER CODE
    ========================================================= */

    function copyReaderCode() {

        const codeElement =
            document.getElementById(
                "readerCodeSnippet"
            );


        const textElement =
            document.getElementById(
                "copyCodeText"
            );


        if (!codeElement) {

            return;

        }


        const code =
            codeElement.textContent;


        if (navigator.clipboard) {

            navigator.clipboard.writeText(code)
                .then(function() {

                    if (textElement) {

                        textElement.textContent =
                            "Copied!";

                        setTimeout(function() {

                            textElement.textContent =
                                "Copy Code";

                        }, 1500);

                    }

                });

        }

    }


    /* =========================================================
       STUDENT ACCESS MODAL
    ========================================================= */

    function closeStudentAccessModal() {

        const modal =
            document.getElementById(
                "studentAccessModal"
            );


        if (modal) {

            modal.style.display = "none";

        }


        document.body.style.overflow = "";

    }


    function checkStudentAccessStatus() {

        const input =
            document.getElementById(
                "studentLookupInput"
            );


        const result =
            document.getElementById(
                "studentLookupResult"
            );


        if (!input || !result) {

            return;

        }


        const query =
            input.value.trim();


        if (!query) {

            result.innerHTML =
                '<div class="error-message">' +
                'Please enter your email or transaction ID.' +
                '</div>';

            return;

        }


        result.innerHTML =
            '<div class="checking-message">' +
            'Checking your enrollment...' +
            '</div>';


        fetch(
            "/Home/CheckEnrollment?query=" +
            encodeURIComponent(query)
        )
            .then(function(response) {

                return response.json();

            })
            .then(function(data) {

                if (
                    !data.success ||
                    !data.enrollments ||
                    data.enrollments.length === 0
                ) {

                    result.innerHTML =
                        '<div class="error-message">' +
                        'No enrollment found.' +
                        '</div>';

                    return;

                }


                let html =
                    '<div class="enrollment-results">';


                data.enrollments.forEach(function(enrollment) {

                    html +=
                        '<div class="enrollment-result-card">' +

                        '<h4>' +
                        (enrollment.courseTitle || "Course") +
                        '</h4>' +

                        '<p>' +
                        '<strong>Status:</strong> ' +
                        (enrollment.status || "Pending") +
                        '</p>' +

                        '<p>' +
                        '<strong>Enrollment Date:</strong> ' +
                        (
                            enrollment.enrolledAt
                                ? new Date(
                                    enrollment.enrolledAt
                                ).toLocaleDateString()
                                : "-"
                        ) +
                        '</p>';


                    if (enrollment.accessCode) {

                        html +=
                            '<p>' +
                            '<strong>Access Code:</strong> ' +
                            enrollment.accessCode +
                            '</p>';

                    }


                    html +=
                        '</div>';

                });


                html +=
                    '</div>';


                result.innerHTML =
                    html;

            })
            .catch(function() {

                result.innerHTML =
                    '<div class="error-message">' +
                    'Unable to check enrollment right now.' +
                    '</div>';

            });

    }


    /* =========================================================
       CLOSE MODALS WHEN CLICKING OUTSIDE
    ========================================================= */

    document.addEventListener(
        "click",
        function(event) {

            if (
                event.target.classList.contains(
                    "course-modal-overlay"
                )
            ) {

                if (
                    event.target.id ===
                    "freeCourseReaderModal"
                ) {

                    closeFreeCourseReader();

                }


                if (
                    event.target.id ===
                    "courseEnrollModal"
                ) {

                    closeCourseEnrollModal();

                }


                if (
                    event.target.id ===
                    "studentAccessModal"
                ) {

                    closeStudentAccessModal();

                }

            }

        }
    );

</script>