@{
    var Courses = ViewBag.Course as List<DaniPortfolio.Models.Course> ?? new();
                
}

<section class="courses-section" id="courses">

    <div class="courses-container">

        <!-- Header -->
        <div class="section-heading">

            <span class="section-label">
                My Learning
            </span>

            <h2>
                Courses & <span>Certifications</span>
            </h2>

            <p>
                Courses and technologies I've learned to improve my
                development skills and build better projects.
            </p>

        </div>


        <!-- Courses -->
        @if (Courses.Any())
        {
            <div class="courses-grid">

                @foreach (var course in Courses)
                {
                    <article class="course-card">

                        <!-- Top -->
                        <div class="course-card-top">

                            <div class="course-icon">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>

                            <span class="course-status
                                @(course.Status?.ToLower() == "completed"
                                    ? "completed"
                                    : "in-progress")">

                                @course.Status

                            </span>

                        </div>


                        <!-- Content -->
                        <div class="course-content">

                            <h3>
                                @course.CourseName
                            </h3>

                            <p class="course-description">
                                @course.Description
                            </p>


                            <!-- Info -->
                            <div class="course-info">

                                <div class="course-info-item">

                                    <i class="fa-solid fa-building"></i>

                                    <div>
                                        <span>Platform</span>
                                        <strong>
                                            @course.Platform
                                        </strong>
                                    </div>

                                </div>


                                <div class="course-info-item">

                                    <i class="fa-solid fa-user"></i>

                                    <div>
                                        <span>Instructor</span>
                                        <strong>
                                            @course.Instructor
                                        </strong>
                                    </div>

                                </div>


                                <div class="course-info-item">

                                    <i class="fa-solid fa-layer-group"></i>

                                    <div>
                                        <span>Level</span>
                                        <strong>
                                            @course.Level
                                        </strong>
                                    </div>

                                </div>


                                <div class="course-info-item">

                                    <i class="fa-solid fa-clock"></i>

                                    <div>
                                        <span>Duration</span>
                                        <strong>
                                            @course.Duration
                                        </strong>
                                    </div>

                                </div>

                            </div>


                            <!-- Technology -->
                            <div class="course-technology">

                                <span>
                                    Technology
                                </span>

                                <strong>
                                    @course.Technology
                                </strong>

                            </div>


                            <!-- Progress -->
                            <div class="course-progress">

                                <div class="progress-header">

                                    <span>
                                        Progress
                                    </span>

                                    <strong>
                                        @course.Progress%
                                    </strong>

                                </div>

                                <div class="progress-bar">

                                    <div class="progress-fill"
                                         style="width:@(course.Progress)%">
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Footer -->
                        <div class="course-footer">

                            <div class="course-date">

                                <i class="fa-regular fa-calendar"></i>

                                <span>
                                    @course.StartDate.ToString("MMM yyyy")
                                </span>

                            </div>


                            @if (course.Certificate)
                            {
                                <span class="certificate-badge">

                                    <i class="fa-solid fa-certificate"></i>

                                    Certificate

                                </span>
                            }


                            @if (!string.IsNullOrWhiteSpace(course.CourseUrl)
                                 && course.CourseUrl != "#")
                            {
                                <a href="@course.CourseUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="course-link">

                                    View Course

                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>

                                </a>
                            }

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <!-- Empty -->
            <div class="courses-empty">

                <i class="fa-solid fa-graduation-cap"></i>

                <h3>
                    No Courses Added Yet
                </h3>

                <p>
                    Courses will appear here once they are added.
                </p>

            </div>
        }

    </div>

</section>