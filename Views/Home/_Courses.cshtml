@model Portfolio.Models.ViewModels.HomeViewModel

@{
    var courses = Model?.Courses ?? Enumerable.Empty<Portfolio.Models.Course>();
}

<section class="courses-section" id="courses">
 
    <div class="courses-container">

        <!-- =====================================================
             SECTION HEADER
        ====================================================== -->

        <div class="section-heading animate">

            <span class="section-label">
                LEARNING ACADEMY &amp; COURSES
            </span>

            <h2>
                Master <span>Full-Stack Development</span>
            </h2>

            <p>
                Study foundational web technologies for free, or enroll in
                premium industry-grade .NET, SQL Server, and full-stack
                engineering masterclasses.
            </p>

        </div>


        <!-- =====================================================
             FILTER TABS
        ====================================================== -->

        <div class="courses-filter-tabs">

            <button type="button"
                    class="course-filter-btn active"
                    data-filter="all"
                    onclick="filterCourses('all', this)">

                <i class="fa-solid fa-layer-group"></i>

                All Courses

                (<span id="totalCoursesCount">
                @courses.Count()
            </span>)

        </button>


        <button type="button"
                class="course-filter-btn free-tab"
                data-filter="free"
                onclick="filterCourses('free', this)">

            <i class="fa-solid fa-gift"></i>

            Free Courses (Learn Free)

        </button>


        <button type="button"
                class="course-filter-btn paid-tab"
                data-filter="paid"
                onclick="filterCourses('paid', this)">

            <i class="fa-solid fa-crown"></i>

            Premium Paid Courses

        </button>


        <button type="button"
                class="course-filter-btn"
                data-filter="backend"
                onclick="filterCourses('backend', this)">

            <i class="fa-solid fa-server"></i>

            Backend &amp; .NET

        </button>


        <button type="button"
                class="course-filter-btn"
                data-filter="frontend"
                onclick="filterCourses('frontend', this)">

            <i class="fa-brands fa-react"></i>

            Frontend

        </button>


        <button type="button"
                class="course-filter-btn"
                data-filter="database"
                onclick="filterCourses('database', this)">

            <i class="fa-solid fa-database"></i>

            Database &amp; ORM

        </button>

    </div>


    <!-- =====================================================
             COURSES GRID
        ====================================================== -->

    <div class="courses-grid"
         id="coursesGridContainer">

        @if (courses.Any())
        {
            foreach (var course in courses)
            {
                var isFree =
                    string.Equals(
                        course.PriceType,
                        "free",
                        StringComparison.OrdinalIgnoreCase
                    )
                    ||
                    string.Equals(
                        course.Price,
                        "free",
                        StringComparison.OrdinalIgnoreCase
                    );

                var category =
                    (course.Category ?? "")
                    .Trim()
                    .ToLowerInvariant();

                var price =
                    string.IsNullOrWhiteSpace(course.Price)
                        ? "PKR 3,500"
                        : course.Price;

                var originalPrice =
                    string.IsNullOrWhiteSpace(course.OriginalPrice)
                        ? "PKR 6,000"
                        : course.OriginalPrice;

                var rating =
                    course.Rating > 0
                        ? course.Rating
                        : 4.9;

                var students =
                    course.EnrolledStudents >= 0
                        ? course.EnrolledStudents
                        : 0;


                <!-- =================================================
                         COURSE CARD
                    ================================================== -->

                <article class="course-card animate"
                         id="course-card-@course.CourseID"
                         data-price-type="@(isFree ? "free" : "paid")"
                         data-category="@category">


                    <!-- CARD TOP -->
                    <div class="course-card-top">


                        <!-- Course Icon -->
                        <div class="course-icon @(isFree ? "icon-free" : "icon-paid")">

                            @if (isFree)
                            {
                                <i class="fa-solid fa-book-open-reader"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-certificate"></i>
                            }

                        </div>


                        <!-- Pricing -->
                        @if (isFree)
                        {
                            <span class="course-pricing-badge free">

                                <i class="fa-solid fa-gift"></i>

                                100% Free

                            </span>
                        }
                        else
                        {
                            <div class="course-price-wrap">

                                <span class="original-price">
                                    @originalPrice
                                </span>

                                <span class="course-pricing-badge paid">

                                    <i class="fa-solid fa-crown"></i>

                                    @price

                                </span>

                            </div>
                        }

                    </div>


                    <!-- =================================================
                             COURSE CONTENT
                        ================================================== -->

                    <div class="course-content">


                        <!-- Category + Level -->
                        <div class="course-meta-top">

                            <span class="course-category-tag">
                                @course.Category
                            </span>


                            <span class="course-level-tag">

                                <i class="fa-solid fa-signal"></i>

                                @(string.IsNullOrWhiteSpace(course.Level)
                                    ? "All Levels"
                                    : course.Level)

                            </span>

                        </div>


                        <!-- Course Title -->
                        <h3>
                            @course.Title
                        </h3>


                        <!-- Subtitle -->
                        @if (!string.IsNullOrWhiteSpace(course.Subtitle))
                        {
                            <p class="course-subtitle">
                                @course.Subtitle
                            </p>
                        }


                        <!-- Description -->
                        <p class="course-description">

                            @(string.IsNullOrWhiteSpace(course.Description)
                                ? "Learn practical skills and build real-world development projects."
                                : course.Description)

                        </p>


                        <!-- =================================================
                                 COURSE INFORMATION
                            ================================================== -->

                        <div class="course-info">


                            <!-- Duration -->
                            <div class="course-info-item">

                                <i class="fa-solid fa-clock"></i>

                                <div>

                                    <span>
                                        Duration
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(course.Duration)
                                            ? "Self Paced"
                                            : course.Duration)
                                    </strong>

                                </div>

                            </div>


                            <!-- Lectures -->
                            <div class="course-info-item">

                                <i class="fa-solid fa-chalkboard-user"></i>

                                <div>

                                    <span>
                                        Lectures
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(course.LecturesCount)
                                            ? "Multiple Lectures"
                                            : course.LecturesCount)
                                    </strong>

                                </div>

                            </div>


                            <!-- Language -->
                            <div class="course-info-item">

                                <i class="fa-solid fa-language"></i>

                                <div>

                                    <span>
                                        Language
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(course.Language)
                                            ? "Urdu / Hindi"
                                            : course.Language)
                                    </strong>

                                </div>

                            </div>


                            <!-- Status -->
                            <div class="course-info-item">

                                <i class="fa-solid fa-circle-check"></i>

                                <div>

                                    <span>
                                        Status
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(course.Status)
                                            ? "Published"
                                            : course.Status)
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                                 CATEGORY / TECHNOLOGY
                            ================================================== -->

                        <div class="course-technology">

                            <span class="tech-label">
                                Category:
                            </span>


                            <span class="tech-badge">
                                @(string.IsNullOrWhiteSpace(course.Category)
                                    ? "Development"
                                    : course.Category)
                            </span>

                        </div>


                        <!-- =================================================
                                 RATING / STUDENTS
                            ================================================== -->

                        <div class="course-progress">

                            <div class="progress-header">

                                <span>

                                    <i class="fa-solid fa-star text-warning"></i>

                                    @rating.ToString("0.0")

                                    (@students students)

                                </span>


                                <strong>

                                    @(isFree
                                        ? "Free Access"
                                        : "Verified Certificate")

                                </strong>

                            </div>


                            <div class="progress-bar">

                                <div class="progress-fill"
                                     style="width:100%;">
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                             COURSE FOOTER
                        ================================================== -->

                    <div class="course-footer">

                        @if (isFree)
                        {
                            <button type="button"
                                    class="course-action-btn free-btn"
                                    onclick="openFreeCourseReader(@course.CourseID)">

                                <i class="fa-solid fa-book-open"></i>

                                Read &amp; Learn Free

                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="course-action-btn paid-btn"
                                    onclick="openCourseEnrollmentModal(@course.CourseID)">

                                <i class="fa-solid fa-cart-shopping"></i>

                                Enroll Now &bull; @price

                            </button>
                        }

                    </div>

                </article>
            }
        }
        else
        {
            <!-- =================================================
                     EMPTY STATE
                ================================================== -->

            <div class="courses-empty">

                <div class="courses-empty-icon">

                    <i class="fa-solid fa-book-open"></i>

                </div>

                <h3>
                    No Courses Available
                </h3>

                <p>
                    Courses will be available soon.
                </p>

            </div>
        }

    </div>

</div>

</section>


