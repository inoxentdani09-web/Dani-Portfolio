@model Portfolio.Models.ViewModels.HomeViewModel

<footer class="footer" id="mainFooter">
    <div class="footer-container">
        <!-- Brand & Bio Column -->
        <div class="footer-box footer-brand-box">
            <div class="footer-logo mb-2">
                <a href="#Home" class="logo-3d-container">
                    <span class="logo-3d-badge">&lt;/&gt;</span>
                    <span class="logo-3d-text">Daniyal<span class="logo-3d-dot">.</span></span>
                </a>
            </div>
            <p class="footer-bio">
                @(Model.Settings?.Tagline ?? "Full-Stack & .NET Software Engineer specializing in ASP.NET Core MVC, React, SQL Server, and enterprise systems.")
            </p>
            <div class="social-links">
                <a href="@(Model.Admin?.GithubUrl ?? "https://github.com/inoxentdani09-web")" target="_blank" rel="noopener noreferrer" title="GitHub" class="social-icon">
                    <i class="fa-brands fa-github"></i>
                </a>
                <a href="@(Model.Admin?.LinkedinUrl ?? "https://linkedin.com")" target="_blank" rel="noopener noreferrer" title="LinkedIn" class="social-icon">
                    <i class="fa-brands fa-linkedin-in"></i>
                </a>
                <a href="@(Model.Admin?.TwitterUrl ?? "https://twitter.com")" target="_blank" rel="noopener noreferrer" title="Twitter" class="social-icon">
                    <i class="fa-brands fa-x-twitter"></i>
                </a>
                <a href="@(Model.Admin?.FacebookUrl ?? "https://facebook.com")" target="_blank" rel="noopener noreferrer" title="Facebook" class="social-icon">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>
            </div>
        </div>

        <!-- Navigation Links Column -->
        <div class="footer-box">
            <h3 class="footer-title">Navigation</h3>
            <ul class="footer-nav-list">
                <li><a href="#Home"><i class="fa-solid fa-angle-right"></i> Home</a></li>
                <li><a href="#About"><i class="fa-solid fa-angle-right"></i> About Overview</a></li>
                <li><a href="#Skills"><i class="fa-solid fa-angle-right"></i> Technical Skills</a></li>
                <li><a href="#Projects"><i class="fa-solid fa-angle-right"></i> Featured Projects</a></li>
                <li><a href="#courses"><i class="fa-solid fa-angle-right"></i> Free & Paid Courses</a></li>
                <li><a href="#Contact"><i class="fa-solid fa-angle-right"></i> Get In Touch</a></li>
            </ul>
        </div>

        <!-- Core Stack Column -->
        <div class="footer-box">
            <h3 class="footer-title">Core Stack</h3>
            <ul class="footer-nav-list">
                <li><a href="#courses"><i class="fa-brands fa-html5" style="color:#e34f26;"></i> HTML5 & CSS3 (Free)</a></li>
                <li><a href="#courses"><i class="fa-brands fa-js" style="color:#f7df1e;"></i> JavaScript ES6+ (Free)</a></li>
                <li><a href="#courses"><i class="fa-solid fa-code" style="color:#9b4dca;"></i> C# & .NET OOP (Paid)</a></li>
                <li><a href="#courses"><i class="fa-solid fa-server" style="color:#38bdf8;"></i> ASP.NET Core & API (Paid)</a></li>
                <li><a href="#courses"><i class="fa-solid fa-database" style="color:#ef4444;"></i> SQL Server DB (Paid)</a></li>
                <li><a href="#courses"><i class="fa-brands fa-react" style="color:#61dafb;"></i> React & Next.js (Paid)</a></li>
            </ul>
        </div>

        <!-- Newsletter & Contact Column -->
        <div class="footer-box">
            <h3 class="footer-title">Direct Contact</h3>
            <p class="footer-desc">
                Feel free to reach out directly for project bookings, custom contracts, or technical queries.
            </p>
            <div style="font-size:13px; color:#cbd5e1; display:flex; flex-direction:column; gap:8px;">
                <div><i class="fa-solid fa-envelope" style="color:#f97316; margin-right:6px;"></i> @(Model.Settings?.Email ?? "inoxentdani09@gmail.com")</div>
                <div><i class="fa-solid fa-phone" style="color:#f97316; margin-right:6px;"></i> @(Model.Settings?.Phone ?? "+92 318 2315238")</div>
                <div><i class="fa-solid fa-location-dot" style="color:#f97316; margin-right:6px;"></i> @(Model.Settings?.Location ?? "Karachi, Pakistan")</div>
            </div>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
        <p>&copy; @DateTime.UtcNow.Year @(Model.Admin?.Name ?? "Daniyal Khan"). All Rights Reserved. Built with ASP.NET Core MVC, Entity Framework Core & SQL Server.</p>
    </div>
</footer>
