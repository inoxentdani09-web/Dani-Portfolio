
@model Portfolio.Models.ViewModels.HomeViewModel

<footer class="footer" id="mainFooter">

    <div class="footer-container">

        <!-- Brand & Bio Column -->
        <div class="footer-box footer-brand-box">

            <div class="footer-logo mb-2">
                <a href="#Home" class="logo-3d-container">

                    <span class="logo-3d-badge">
                        &lt;/&gt;
                    </span>

                    <span class="logo-3d-text">
                        Daniyal<span class="logo-3d-dot">.</span>
                    </span>

                </a>
            </div>


            <p class="footer-bio">
                @(Model.Settings?.Tagline ??
                    "Senior Full-Stack & .NET Software Engineer specializing in ASP.NET Core MVC, React, SQL Server, and enterprise cloud systems.")
            </p>


            <!-- Social Links -->
            <div class="social-links">

                <a href="@(string.IsNullOrWhiteSpace(Model.Admin?.GithubUrl)
                                       ? "https://github.com/inoxentdani09-web"
                                       : Model.Admin.GithubUrl)"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="GitHub"
                   class="social-icon">

                    <i class="fa-brands fa-github"></i>

                </a>


                <a href="@(string.IsNullOrWhiteSpace(Model.Admin?.LinkedinUrl)
                                       ? "https://linkedin.com"
                                       : Model.Admin.LinkedinUrl)"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="LinkedIn"
                   class="social-icon">

                    <i class="fa-brands fa-linkedin-in"></i>

                </a>


                <a href="@(string.IsNullOrWhiteSpace(Model.Admin?.TwitterUrl)
                                       ? "https://twitter.com"
                                       : Model.Admin.TwitterUrl)"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Twitter"
                   class="social-icon">

                    <i class="fa-brands fa-x-twitter"></i>

                </a>


                <a href="@(string.IsNullOrWhiteSpace(Model.Admin?.FacebookUrl)
                                       ? "https://facebook.com"
                                       : Model.Admin.FacebookUrl)"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Facebook"
                   class="social-icon">

                    <i class="fa-brands fa-facebook-f"></i>

                </a>

            </div>

        </div>


        <!-- Navigation Links Column -->
        <div class="footer-box">

            <h3 class="footer-title">
                Navigation
            </h3>

            <ul class="footer-nav-list">

                <li>
                    <a href="#Home">
                        <i class="fa-solid fa-angle-right"></i>
                        Home
                    </a>
                </li>

                <li>
                    <a href="#About">
                        <i class="fa-solid fa-angle-right"></i>
                        About Overview
                    </a>
                </li>

                <li>
                    <a href="#Skills">
                        <i class="fa-solid fa-angle-right"></i>
                        Technical Skills
                    </a>
                </li>

                <li>
                    <a href="#Projects">
                        <i class="fa-solid fa-angle-right"></i>
                        Featured Projects
                    </a>
                </li>

                <li>
                    <a href="#courses">
                        <i class="fa-solid fa-angle-right"></i>
                        Free & Paid Courses
                    </a>
                </li>

                <li>
                    <a href="#Contact">
                        <i class="fa-solid fa-angle-right"></i>
                        Get In Touch
                    </a>
                </li>

            </ul>

        </div>


        <!-- Core Stack Column -->
        <div class="footer-box">

            <h3 class="footer-title">
                Core Stack
            </h3>

            <ul class="footer-nav-list">

                <li>
                    <a href="#courses">
                        <i class="fa-brands fa-html5"
                           style="color:#e34f26;">
                        </i>
                        HTML5 & CSS3 (Free)
                    </a>
                </li>

                <li>
                    <a href="#courses">
                        <i class="fa-brands fa-js"
                           style="color:#f7df1e;">
                        </i>
                        JavaScript ES6+ (Free)
                    </a>
                </li>

                <li>
                    <a href="#courses">
                        <i class="fa-solid fa-code"
                           style="color:#9b4dca;">
                        </i>
                        C# & .NET OOP (Paid)
                    </a>
                </li>

                <li>
                    <a href="#courses">
                        <i class="fa-solid fa-server"
                           style="color:#38bdf8;">
                        </i>
                        ASP.NET Core & API (Paid)
                    </a>
                </li>

                <li>
                    <a href="#courses">
                        <i class="fa-solid fa-database"
                           style="color:#ef4444;">
                        </i>
                        SQL Server DB (Paid)
                    </a>
                </li>

                <li>
                    <a href="#courses">
                        <i class="fa-brands fa-react"
                           style="color:#61dafb;">
                        </i>
                        React & Next.js (Paid)
                    </a>
                </li>

            </ul>

        </div>


        <!-- Newsletter & Contact Column -->
        <div class="footer-box">

            <h3 class="footer-title">
                Stay Updated
            </h3>

            <p class="footer-desc">
                Subscribe for new course releases, coding tutorials, and tech articles.
            </p>


            <!-- Newsletter -->
            <form class="newsletter-form"
                  onsubmit="event.preventDefault(); document.getElementById('newsletterFeedback').style.display='block'; this.reset();">

                <div class="newsletter-input-group">

                    <input type="email"
                           placeholder="Enter your email..."
                           required />

                    <button type="submit"
                            title="Subscribe">

                        <i class="fa-solid fa-paper-plane"></i>

                    </button>

                </div>


                <div id="newsletterFeedback"
                     style="display:none; color:#10b981; font-size:12px; margin-top:8px;">

                    <i class="fa-solid fa-circle-check me-1"></i>

                    Thank you! You're now subscribed.

                </div>

            </form>


            <!-- Contact Information -->
            <div class="footer-contact-info">

                <div>

                    <i class="fa-solid fa-location-dot"></i>

                    <span>
                        @(Model.Settings?.Location ?? "Karachi, Pakistan")
                    </span>

                </div>


                <div>

                    <i class="fa-solid fa-envelope"></i>

                    <a href="mailto:@(Model.Settings?.Email ?? "inoxentdani09@gmail.com")">

                        @(Model.Settings?.Email ?? "inoxentdani09@gmail.com")

                    </a>

                </div>


                <div>

                    <i class="fa-solid fa-phone"></i>

                    <a href="tel:@(Model.Settings?.Phone ?? "+923182315238")">

                        @(Model.Settings?.Phone ?? "+92 318 2315238")

                    </a>

                </div>

            </div>


            <!-- Admin Button -->
            <div class="footer-admin-btn-wrap">

                <a href="/Admin/Login"
                   class="admin-portal-link">

                    <i class="fa-solid fa-shield-halved"></i>

                    Admin Control Panel

                </a>

            </div>

        </div>

    </div>


    <!-- Bottom Bar -->
    <div class="footer-bottom">

        <div class="footer-bottom-container">

            <p class="copyright-text">

                &copy; @DateTime.Now.Year

                <strong>
                    @(Model.Admin?.Name ?? "Daniyal Khan")
                </strong>.

                All rights reserved.

            </p>


            <div class="footer-bottom-links">

                <a href="#Home">

                    Back to Top

                    <i class="fa-solid fa-arrow-up ms-1"></i>

                </a>

                <span>&bull;</span>

                <a href="/Admin/Login">
                    Admin Login
                </a>

            </div>

        </div>

    </div>

</footer>

