@{
    var skills = ViewBag.Skills as List<DaniPortfolio.Models.Skill> ?? new();
}
   


<Section id="Skills">
    <div class="skill-bg">
        <div class="Skill-content animate">
            <h1 class="section-title">My Skills</h1>
            <h1>Technologies I <span>Work With</span></h1>
            <p>As a Full Stack Developer, I work across the entire development stack — from responsive front-end interfaces built with HTML5, CSS3, Tailwind CSS, and React, to secure back-end systems powered by ASP.NET MVC, .NET Core, and SQL Server.</p>
        </div>
        <div class="Skills-Container">
            @foreach (var skill in skills)
            {
                <div class="skill-card animate">
                    <div class="skill-icon">
                        <img src="/images/@skill.Icon" alt="@skill.Name icon" />
                    </div>
                    <h3>@skill.Name</h3>
                    <p>@skill.Description</p>
                </div>
            }
        </div>
    </div>
</Section>