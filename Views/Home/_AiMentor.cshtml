        background: linear-gradient(135deg, #f97316, #ea580c);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 16px;
    }


    .ai-chat-header h4 {
        margin: 0;
        font-size: 14.5px;
        font-weight: 700;
