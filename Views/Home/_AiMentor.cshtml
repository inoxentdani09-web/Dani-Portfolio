    }


    .ai-header-btn {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: inline-flex;
