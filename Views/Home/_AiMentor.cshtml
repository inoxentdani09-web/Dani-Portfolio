        color: #38bdf8;
        overflow-x: auto;
    }


    /* Chat Input Form */

    .ai-chat-input-area {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: rgba(15, 23, 42, 0.98);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }


        .ai-chat-input-area input {
            flex: 1;
            background: #0b1120;
            border: 1px solid rgba(255, 255, 255, 0.12);
