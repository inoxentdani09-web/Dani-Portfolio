
<!-- =========================================================
     DANIYAL AI CODE MENTOR & ASSISTANT WIDGET
     ========================================================= -->

<div class="ai-mentor-wrapper" id="aiMentorWidget">

    <!-- Floating AI Trigger Button -->
    <button type="button"
            class="ai-mentor-floating-btn"
            id="aiMentorToggleBtn"
            onclick="toggleAiMentorChat()"
            aria-label="Open Daniyal AI Assistant">

        <div class="ai-btn-glow"></div>

        <div class="ai-btn-icon">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
        </div>

        <span class="ai-btn-label">
            Daniyal AI
        </span>

        <span class="ai-btn-status-dot"></span>

    </button>


    <!-- AI Chat Window Panel -->
    <div class="ai-chat-panel"
         id="aiChatPanel"
         style="display:none;">

        <!-- Panel Header -->
        <div class="ai-chat-header">

            <div class="ai-header-left">

                <div class="ai-avatar-badge">
                    <i class="fa-solid fa-robot"></i>
                </div>

                <div>

                    <h4>
                        Daniyal AI Mentor

                        <span class="ai-version-pill">
                            Gemini 3.8
                        </span>
                    </h4>

                    <span class="ai-status-text">
                        <i class="fa-solid fa-circle text-success me-1"></i>
                        Live Portfolio & Code Assistant
                    </span>

                </div>

            </div>


            <div class="ai-header-actions">

                <button type="button"
                        class="ai-header-btn"
                        onclick="clearAiChat()"
                        title="Clear Chat">

                    <i class="fa-solid fa-rotate-left"></i>

                </button>


                <button type="button"
                        class="ai-header-btn"
                        onclick="toggleAiMentorChat()"
                        title="Close">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </div>

        </div>


        <!-- Chat Quick Suggestions / Topic Chips -->
        <div class="ai-prompt-chips-wrap">

            <button type="button"
                    class="ai-chip"
                    onclick="sendAiQuickPrompt('Explain HTML5 semantic structure and give a template')">

                <i class="fa-brands fa-html5"></i>
                HTML5 Starter

            </button>


            <button type="button"
                    class="ai-chip"
                    onclick="sendAiQuickPrompt('How does CSS3 Flexbox vs Grid work?')">

                <i class="fa-brands fa-css3-alt"></i>
                Flexbox vs Grid

            </button>


            <button type="button"
                    class="ai-chip"
                    onclick="sendAiQuickPrompt('How does C# ASP.NET Core connect with SQL Server?')">

                <i class="fa-solid fa-cubes"></i>
                .NET & SQL Server

            </button>


            <button type="button"
                    class="ai-chip"
                    onclick="sendAiQuickPrompt('Which free course should I start with on this portfolio?')">

                <i class="fa-solid fa-graduation-cap"></i>
                Course Roadmap

            </button>

        </div>


        <!-- Messages Container -->
        <div class="ai-chat-messages"
             id="aiChatMessages">

            <div class="ai-msg ai-msg-bot">

                <div class="ai-msg-avatar">
                    <i class="fa-solid fa-robot"></i>
                </div>

                <div class="ai-msg-bubble">

                    <p>
                        <strong>
                            Hi there! 👋 I'm Daniyal Khan's AI Assistant.
                        </strong>
                    </p>

                    <p>
                        Ask me anything about HTML5/CSS3/JavaScript coding,
                        C# & ASP.NET Core architecture, SQL Server database
                        queries, or course recommendations!
                    </p>

                </div>

            </div>

        </div>


        <!-- Chat Input Form -->
        <form class="ai-chat-input-area"
              id="aiChatForm"
              onsubmit="handleAiChatSubmit(event)">

            <input type="text"
                   id="aiChatInput"
                   placeholder="Ask AI a coding question or about courses..."
                   autocomplete="off"
                   required />

            <button type="submit"
                    id="aiChatSendBtn"
                    class="ai-send-btn"
                    aria-label="Send message">

                <i class="fa-solid fa-paper-plane"></i>

            </button>

        </form>

    </div>

</div>


<style>

    /* AI Mentor Floating Widget Styles */

    .ai-mentor-wrapper {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 10000;
    }


    .ai-mentor-floating-btn {
        position: relative;
        display: flex;
        align-items: center;
        gap: 7px;
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid rgba(249, 115, 22, 0.5);
        color: #ffffff;
        padding: 7px 14px;
        border-radius: 24px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5), 0 0 14px rgba(249, 115, 22, 0.25);
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }


        .ai-mentor-floating-btn:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 8px 24px rgba(249, 115, 22, 0.4);
            border-color: #f97316;
        }


    .ai-btn-icon {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f97316, #ea580c);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 12.5px;
        box-shadow: 0 0 8px rgba(249, 115, 22, 0.5);
    }


    .ai-btn-label {
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.2px;
        color: #f8fafc;
    }


    .ai-btn-status-dot {
        width: 7px;
        height: 7px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 6px #10b981;
        animation: aiPulse 2s infinite;
    }


    @@keyframes aiPulse {

        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(0.85);
        }
    }


    /* AI Chat Panel Window */

    .ai-chat-panel {
        position: absolute;
        bottom: 50px;
        right: 0;
        width: 360px;
        max-width: calc(100vw - 28px);
        height: 500px;
        max-height: calc(100vh - 100px);
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(28px) saturate(180%);
        -webkit-backdrop-filter: blur(28px) saturate(180%);
        border: 1px solid rgba(249, 115, 22, 0.35);
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 25px rgba(249, 115, 22, 0.2);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        animation: aiFadeIn 0.3s ease;
    }


    @@keyframes aiFadeIn {

        from {
            opacity: 0;
            transform: translateY(15px) scale(0.96);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }


    .ai-chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        background: rgba(24, 34, 60, 0.7);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }


    .ai-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    .ai-avatar-badge {
        width: 34px;
