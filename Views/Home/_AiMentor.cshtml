        overflow-x: auto;
        white-space: nowrap;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        scrollbar-width: none;
    }


        .ai-prompt-chips-wrap::-webkit-scrollbar {
            display: none;
        }


    .ai-chip {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(249, 115, 22, 0.25);
