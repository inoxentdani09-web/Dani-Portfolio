<Section id="About">
    <div class="About-Content animate">
        <div class="About-Right">
            <div class="About-image animate">
                <img src="~/Images/AboutMe.png" alt="Daniyal - Full Stack Developer" />
            </div>
        </div>

        <div class="About-Left animate">
            <div>
                <p class="about-title ">About Me</p>
            </div>
            <div>

                <h3>Who I Am</h3>
            </div>
            <p class="about-p-2 animate">
                I'm Daniyal, a Full Stack Developer with a strong passion for building complete, real-world digital
                solutions. On the front end, I craft clean and responsive interfaces using HTML5, CSS3, Tailwind CSS,
                JavaScript, and React. On the back end, I build reliable, secure applications using ASP.NET MVC,
                .NET Core, Entity Framework, and SQL Server. I'm currently open to freelance projects and
                collaborations with clients across Pakistan, India, and internationally.
            </p>
            <div class="bord"></div>
            <div class="card-about animate">
                <div class="About-Card animate">
                    <div class="card-1 animate">
                        <div class="About-card-pic">
                            <div class="About-icon">
                                <i class="fa-solid fa-palette icon"></i>
                            </div>
                            <div class="About-Card-Text">
                                <h5>UI/UX Design</h5>
                                <p>Designing Beautiful Digital Interfaces</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-1 animate">
                        <div class="About-card-pic">
                            <div class="About-icon">
                                <i class="fa-solid fa-code icon"></i>
                            </div>
                            <div class="About-Card-Text">
                                <h5>Web Development </h5>
                                <p>Building Fast & Responsive Websites</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="About-Card animate">
                    <div class="card-1 animate">
                        <div class="About-card-pic">
                            <div class="About-icon">
                                <i class="fa-solid fa-mobile-screen icon"></i>
                            </div>
                            <div class="About-Card-Text">
                                <h5>Responsive Design</h5>
                                <p>Responsive Designs for Every Screen</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-1 animate">
                        <div class="About-card-pic">
                            <div class="About-icon">
                                <i class="fa-solid fa-laptop-code icon"></i>
                            </div>
                            <div class="About-Card-Text">
                                <h5>Clean Code</h5>
                                <p>Writing Clean & Maintainable Code</p>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Section>
<div class="main-stats-Section">
    <div class="stats-Section">
        <div class="About-stats-pic">
            <div class="About-stats-icon">
                <i class="fa-solid fa-graduation-cap icons"></i>
            </div>
            <div class="About-stats-text">
                <h5>@ViewBag.LearnCount</h5>
                <p>Learning Course</p>

            </div>
        </div>
        <div class="About-stats-pic">
            <div class="About-stats-icon">
                <i class="fa-solid fa-diagram-project icons"></i>
            </div>
            <div class="About-stats-text">
                <h5>@ViewBag.ProjectsCount</h5>
                <p>Projects Completed</p>

            </div>
        </div>
        <div class="About-stats-pic">
            <div class="About-stats-icon">
                <i class="fa-solid fa-briefcase icons"></i>
            </div>
            <div class="About-stats-text">
                <h5>1+</h5>
                <p>Years Of Experience</p>

            </div>
        </div>
        <div class="About-stats-pic">
            <div class="About-stats-icon">
                <i class="fa-solid fa-laptop-code icons"></i>
            </div>
            <div class="About-stats-text">
                <h5>@ViewBag.SkillsCount</h5>
                <p>Technologies</p>

            </div>
        </div>
        <div>
            <button class="stats-btn"> <i class="fa-solid fa-download"></i>Download CV</button>
        </div>
    </div>
</div>