<script>

    (function() {

        function toggleSidebarMenu() {

            var navLinks =
                document.getElementById('navLinksList');

            var backdrop =
                document.getElementById('navBackdrop');

            if (!navLinks) return;

            var isOpen =
                navLinks.classList.toggle('active');

            if (backdrop) {

                if (isOpen) {

                    backdrop.classList.add('show');

                    document.body.style.overflow = 'hidden';

                }
                else {

                    backdrop.classList.remove('show');

                    document.body.style.overflow = '';

                }
            }
        }


        function closeSidebarMenu() {

            var navLinks =
                document.getElementById('navLinksList');

            var backdrop =
                document.getElementById('navBackdrop');

            if (navLinks)
                navLinks.classList.remove('active');

            if (backdrop)
                backdrop.classList.remove('show');

            document.body.style.overflow = '';
        }


        window.toggleSidebarMenu =
            toggleSidebarMenu;

        window.closeSidebarMenu =
            closeSidebarMenu;

        window.closeMenu =
            closeSidebarMenu;


        document.addEventListener(
            'DOMContentLoaded',
            function() {

                var menuBtn =
                    document.getElementById('navMenuBtn');

                var backdrop =
                    document.getElementById('navBackdrop');

                var navItemLinks =
                    document.querySelectorAll('.nav-item-link');


                if (menuBtn) {

                    menuBtn.addEventListener(
                        'click',
                        function(e) {

                            e.stopPropagation();

                            toggleSidebarMenu();

                        }
                    );
                }


                if (backdrop) {

                    backdrop.addEventListener(
                        'click',
                        closeSidebarMenu
                    );

                }


                navItemLinks.forEach(
                    function(link) {

                        link.addEventListener(
                            'click',
                            function() {

                                closeSidebarMenu();

                                navItemLinks.forEach(
                                    function(l) {
                                        l.classList.remove('active');
                                    }
                                );

                                link.classList.add('active');

                            }
                        );

                    }
                );


                // Scrollspy active state
                window.addEventListener(
                    'scroll',
                    function() {

                        var sections =
                            document.querySelectorAll(
                                'section, Section, header'
                            );

                        var scrollPos =
                            window.scrollY + 120;


                        sections.forEach(
                            function(sec) {

                                var id =
                                    sec.getAttribute('id');

                                if (id) {

                                    var top =
                                        sec.offsetTop;

                                    var height =
                                        sec.offsetHeight;


                                    if (
                                        scrollPos >= top &&
                                        scrollPos < top + height
                                    ) {

                                        navItemLinks.forEach(
                                            function(l) {

                                                l.classList.remove(
                                                    'active'
                                                );

                                                if (
                                                    l.getAttribute('href') ===
                                                    '#' + id
                                                ) {

                                                    l.classList.add(
                                                        'active'
                                                    );

                                                }

                                            }
                                        );

                                    }

                                }

                            }
                        );

                    }
                );

            }
        );

    })();

</script>

