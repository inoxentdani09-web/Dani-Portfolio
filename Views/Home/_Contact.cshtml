@model Portfolio.Models.ViewModels.HomeViewModel

<section class="contact" id="Contact">
    <div class="Learn-content animate">
        <div class="section-title">
            <span>Get In Touch</span>
        </div>

        <h2>Let's Work <span>Together</span></h2>
        <p>
            Have an exciting web application, e-commerce platform, or custom software project? 
            Fill out the form below or contact me directly. I will respond to your inquiry promptly.
        </p>
    </div>

    <div class="contact-container animate">
        <!-- Success Alert container -->
        <div id="contactFormAlert" style="@(!string.IsNullOrEmpty(Model.MessageSuccess) ? "display:flex;" : "display:none;") align-items:center; background:rgba(34, 197, 94, 0.15); border:1px solid #22c55e; border-radius:12px; padding:14px 18px; margin-bottom:24px; color:#fff; width:100%; box-shadow:0 8px 25px rgba(34,197,94,0.2);">
            <div style="margin-right:14px; font-size:20px; color:#22c55e;">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div style="flex:1;">
                <strong style="display:block; color:#22c55e; font-size:15px; margin-bottom:2px;">Message Received!</strong>
                <span id="contactAlertText" style="font-size:13px; color:#cbd5e1;">@(Model.MessageSuccess ?? "Your message has been sent successfully. Daniyal will contact you shortly!")</span>
            </div>
            <div onclick="this.parentElement.style.display='none'" style="cursor:pointer; color:#94a3b8; font-size:16px;">
                <i class="fa-solid fa-xmark"></i>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="contact-form animate">
            <form id="portfolioContactForm" asp-controller="Home" asp-action="SendMessage" method="post">
                @Html.AntiForgeryToken()
                <div class="input-group">
                    <input type="text"
                           name="Name"
                           id="contactName"
                           placeholder="Your Full Name *"
                           required />
                </div>

                <div class="input-group">
                    <input type="email"
                           name="Email"
                           id="contactEmail"
                           placeholder="Your Email Address *"
                           required />
                </div>

                <div class="input-group">
                    <input type="tel"
                           name="Phone"
                           id="contactPhone"
                           placeholder="Your Phone Number (Optional)" />
                </div>

                <div class="input-group">
                    <input type="text"
                           name="Subject"
                           id="contactSubject"
                           placeholder="Project Subject / Topic *"
                           required />
                </div>

                <div class="input-group">
                    <textarea rows="5"
                              name="MessageText"
                              id="contactMessage"
                              placeholder="Tell me about your project, timeline, and requirements... *"
                              required></textarea>
                </div>

                <button type="submit" class="btn" id="contactSubmitBtn">
                    <i class="fa-solid fa-paper-plane"></i>
                    <span id="contactBtnText">Send Message</span>
                </button>
            </form>
        </div>

        <!-- Contact Info -->
        <div class="contact-info animate">
            <div class="info-box">
                <i class="fa-solid fa-envelope"></i>
                <div>
                    <h4>Direct Email</h4>
                    <p><a href="mailto:@(Model.Settings?.Email ?? "inoxentdani09@gmail.com")" style="color:inherit; text-decoration:none;">@(Model.Settings?.Email ?? "inoxentdani09@gmail.com")</a></p>
                </div>
            </div>

            <div class="info-box">
                <i class="fa-solid fa-phone"></i>
                <div>
                    <h4>Phone & WhatsApp</h4>
                    <p><a href="tel:@(Model.Settings?.Phone ?? "+923182315238")" style="color:inherit; text-decoration:none;">@(Model.Settings?.Phone ?? "+92 318 2315238")</a></p>
                </div>
            </div>

            <div class="info-box">
                <i class="fa-solid fa-location-dot"></i>
                <div>
                    <h4>Location</h4>
                    <p>@(Model.Settings?.Location ?? "Karachi, Pakistan")</p>
                </div>
            </div>

            <div class="info-box">
                <i class="fa-solid fa-clock"></i>
                <div>
                    <h4>Availability</h4>
                    <p>@(Model.Settings?.WorkingHours ?? "Mon - Sat: 9:00 AM - 6:00 PM")</p>
                </div>
            </div>

            <div class="social-links-contact" style="display:flex; gap:12px; margin-top:20px;">
                <a href="@(Model.Admin?.GithubUrl ?? "https://github.com/inoxentdani09-web")" target="_blank" rel="noopener noreferrer" style="width:42px; height:42px; border-radius:50%; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); color:#fff; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; font-size:18px;">
                    <i class="fa-brands fa-github"></i>
                </a>
                <a href="@(Model.Admin?.LinkedinUrl ?? "https://linkedin.com/in/daniyal-developer")" target="_blank" rel="noopener noreferrer" style="width:42px; height:42px; border-radius:50%; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); color:#fff; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; font-size:18px;">
                    <i class="fa-brands fa-linkedin-in"></i>
                </a>
            </div>
        </div>
    </div>
</section>
