@model DaniPortfolio.ViewModals.SkillViewModal;

```html
<div class="skill-modal-overlay" id="skillModalOverlay">

    <div class="skill-modal">

        <div class="skill-modal-header">
            <div>
                <span>SKILL MANAGEMENT</span>
                <h2 id="skillModalTitle">Add Skill</h2>
            </div>

            <button type="button"
                    class="skill-modal-close"
                    id="skillModalClose">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>


        <form asp-action="SaveSkill"
              asp-controller="Admin"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden"
                   name="Id"
                   id="SkillId"
                   value="0" />

            <div class="skill-form-grid">

                <!-- Name -->
                <div class="skill-input-group">
                    <label>Skill Name</label>

                    <input type="text"
                           name="Name"
                           id="SkillName"
                           placeholder="e.g. C#"
                           required />
                </div>


                <!-- Icon -->
                <div class="skill-input-group">
                    <label>Icon</label>

                    <input type="text"
                           name="Icon"
                           id="SkillIcon"
                           placeholder="e.g. csharp.png"
                           required />
                </div>


                <!-- Skill Image -->
                <div class="skill-input-group full">

                    <label>Skill Image</label>

                    <div class="skill-image-upload">

                        <div class="skill-image-preview"
                             id="skillImagePreview">

                            <i class="fa-regular fa-image"></i>

                            <span>Preview</span>

                        </div>

                        <div class="skill-image-input">

                            <input type="file"
                                   name="SkillImage"
                                   id="SkillImage"
                                   accept="image/png,image/jpeg,image/jpg,image/webp" />

                            <small>
                                PNG, JPG, JPEG or WEBP
                            </small>

                        </div>

                    </div>

                </div>


                <!-- Category -->
                <div class="skill-input-group">
                    <label>Category</label>

                    <select name="Category"
                            id="SkillCategory"
                            required>

                        <option value="">Select Category</option>
                        <option value="Frontend">Frontend</option>
                        <option value="Backend">Backend</option>
                        <option value="Database">Database</option>
                        <option value="Tools">Tools</option>

                    </select>
                </div>


                <!-- Level -->
                <div class="skill-input-group">
                    <label>Level</label>

                    <select name="Level"
                            id="SkillLevel"
                            required>

                        <option value="">Select Level</option>
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                        <option value="Expert">Expert</option>

                    </select>
                </div>


                <!-- Status -->
                <div class="skill-input-group">
                    <label>Status</label>

                    <select name="Status"
                            id="SkillStatus"
                            required>

                        <option value="">Select Status</option>
                        <option value="Published">Published</option>
                        <option value="Draft">Draft</option>

                    </select>
                </div>


                <!-- Description -->
                <div class="skill-input-group full">

                    <label>Description</label>

                    <textarea name="Description"
                              id="SkillDescription"
                              rows="4"
                              placeholder="Write skill description..."
                              required></textarea>

                </div>

            </div>


            <div class="skill-modal-footer">

                <button type="button"
                        class="skill-btn cancel"
                        id="skillModalCancel">
                    Cancel
                </button>

                <button type="submit"
                        class="skill-btn save">

                    <i class="fa-solid fa-floppy-disk"></i>

                    <span id="skillSaveText">
                        Save Skill
                    </span>

                </button>

            </div>

        </form>

    </div>

</div>
```