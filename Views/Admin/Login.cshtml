@{
    Layout = null;
}
@model DaniPortfolio.Models.Admin;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login - Daniyal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="@(Url.Content("~/css/Login.css"))" />
</head>
<body>
    <main class="login-page">
        <section class="promo" aria-hidden="true">
            <div class="promo-inner">
                <div class="promo-icon">&lt;/&gt;</div>
                <h1 class="promo-title">Admin <span>Panel</span></h1>
                <p class="promo-desc">Manage your portfolio, projects,<br />skills and messages in one place.</p>

                <div class="promo-art" aria-hidden="true">
                    <div class="laptop">
                        <div class="screen">
                            <img src="/Images/laptop.png" />
                        </div>
                        <div class="mug">&lt;/&gt;</div>
                    </div>
                </div>
            </div>
        </section>

        <div class="divider" aria-hidden="true"></div>

        <section class="card-wrap">
            <div class="card" role="region" aria-label="Admin sign in">
                <div class="card-badge" aria-hidden="true"><i class="fa-solid fa-lock"></i></div>
                <h2 class="card-title">Welcome Back!</h2>
                <p class="card-sub">Please sign in to your admin account</p>
                @if (ViewBag.Error != null)
                    {
                        <div class="text-danger">
                        @ViewBag.Error
                        </div>
                    }
                <form class="login-form" method="post" asp-action="Login" novalidate>
                    <label class="field">
                        <span class="label">Email Address</span>
                        <div class="input-wrap">
                            <i class="fa-regular fa-envelope fa-fw"></i>
                            <input type="email" name="email" asp-for=" Email" placeholder="Enter your email" required autocomplete="username" />
                        </div>
                    </label>

                    <label class="field">
                        <span class="label">Password</span>
                        <div class="input-wrap">
                            <i class="fa-solid fa-lock fa-fw"></i>
                            <input type="password" name="password" asp-for="Password" placeholder="Enter your password" required autocomplete="current-password" />
                            <button type="button" class="eye" aria-hidden="true"><i class="fa-regular fa-eye"></i></button>
                        </div>
                    </label>

                    <div class="form-row">
                        <label class="remember">
                            <input type="checkbox" name="remember" />
                            <span>Remember me</span>
                        </label>
                        <a class="forgot" href="#">Forgot password?</a>
                    </div>

                    <button class="btn-primary" type="submit"><i class="fa-solid fa-right-to-bracket"></i> Sign In</button>

                    <div class="or">
                        <span>OR</span>
                    </div>

                    <a class="back-link" href="/">Back to Website <i class="fa-solid fa-arrow-right-long"></i></a>
                </form>
            </div>
        </section>
    </main>
</body>
</html>
