@model DaniPortfolio.ViewModals.ProjectsViewModal;
<div class="add-project-modal" id="addProjectModal">
    <div class="Project-modal">

        <!-- Header -->
        <div class="Project-modal-header">
            <div>
                <h2>Add New Project</h2>
                <p>Create and publish your portfolio project</p>
            </div>

            <button class="close-btn" onclick="closeProjectModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form asp-action="CreateProjects" asp-controller="Admin" method="post" enctype="multipart/form-data">
            <!-- Body -->
            <div class="Project-modal-body">

                <!-- Basic Information -->
                <h3 class="section-title">Basic Information</h3>
                <input asp-for="project.ProjectID" type="hidden" id="ProjectID" />
                <div class="form-group">
                    <label>Project Title</label>
                    <input asp-for="project.Title" class="form-control" id="Title" type="text" placeholder="Enter project title">
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <textarea asp-for="project.Description" id="Description" rows="5" placeholder="Write project description"></textarea>
                </div>

                <div class="grid">

                    <div class="form-group">
                        <label>Category</label>
                        <select asp-for="project.category" id="Category">
                            <option>Select Category</option>
                            <option>Portfolio</option>
                            <option>Dashboard</option>
                            <option>E-Commerce</option>
                            <option>Dekstop Application</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Technology</label>
                        <select asp-for="project.Technalogy" id="Technalogy">
                            <option>Select Technology</option>
                            <option>ASP.NET Core</option>
                            <option>C#</option>
                            <option>HTML/CSS</option>
                            <option>HTML/CSS/JavaScript</option>

                        </select>
                    </div>
                    <div class="form-group">
                        <select asp-for="project.Status" id="Status">
                            <option>Select Status</option>

                            <option value="Published">Published</option>
                            <option value="Draft">Draft</option>
                            <option value="Completed">Completed</option>
                            <option value="In Progress">In Progress</option>
                            <option value="On Hold">On Hold</option>
                        </select>
                    </div>
                </div>

                <!-- Project Links -->
                <h3 class="section-title">Project Links</h3>

                <div class="form-group">
                    <label>GitHub URL</label>
                    <input asp-for="project.GitHub" id="GitHub" type="url" placeholder="https://github.com/...">
                </div>

                <div class="form-group">
                    <label>Live Demo URL</label>
                    <input asp-for="project.LiveDemo" id="LiveDemo" type="url" placeholder="https://...">
                </div>

                <!-- Upload -->
                <h3 class="section-title">Project Image</h3>

                <div class="form-group ">
                    <label>Upload Image</label>
                </div>
                <input type="file" name="ImageFile" id="ImageFile" class="upload-btn">
                <div class="image-preview">
                    <img id="ProjectImagePreview"
                         src=""
                         style="margin-top:15px;width:120px;height:90px;object-fit:cover;display:none;">
                </div>
            </div>

            <!-- Footer -->
            <div class="Project-modal-footer">

                <button class="btn-secondary" type="button" onclick="window.location.href='/Admin/Dashboard'">
                    Cancel
                </button>

                <button class="btn-primary" type="submit">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Save Project
                </button>

            </div>
        </form>
    </div>
</div>