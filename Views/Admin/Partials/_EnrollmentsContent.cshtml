@model Portfolio.Models.ViewModels.AdminDashboardViewModel

<div class="content-box mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="box-title m-0"><i class="fa-solid fa-id-card-clip me-2 text-warning"></i>Student Enrollments & Access</h4>
            <p class="text-muted m-0" style="font-size:13px;">Manage course student registrations and verify transaction proofs</p>
        </div>
        <a href="/Admin/ExportEnrollments" class="btn btn-outline-light btn-sm">
            <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Course Title</th>
                    <th>Contact Info</th>
                    <th>Payment Method</th>
                    <th>Transaction ID</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Enrollments.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No student enrollments found.</td>
                    </tr>
                }
                @foreach (var e in Model.Enrollments)
                {
                    <tr id="enrollment-row-@e.EnrollmentID">
                        <td><strong style="color:var(--text-main);">@e.StudentName</strong></td>
                        <td><span class="badge bg-secondary">@e.CourseTitle</span></td>
                        <td>
                            <small class="d-block text-muted">@e.StudentEmail</small>
                            <small class="text-muted">@e.StudentPhone</small>
                        </td>
                        <td><span class="badge bg-info text-dark">@e.PaymentMethod</span></td>
                        <td><code style="background:rgba(0,0,0,0.3); padding:2px 6px; border-radius:4px; font-size:11px;">@e.TransactionId</code></td>
                        <td>
                            @if (e.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (e.Status == "Rejected")
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td><small>@e.EnrolledAt.ToString("MMM dd, yyyy")</small></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-success" onclick="updateEnrollmentStatus(@e.EnrollmentID, 'Approved')" title="Approve Access">
                                    <i class="fa-solid fa-check"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" onclick="updateEnrollmentStatus(@e.EnrollmentID, 'Rejected')" title="Reject">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
