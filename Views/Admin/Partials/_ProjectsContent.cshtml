@model Portfolio.Models.ViewModels.AdminDashboardViewModel

<div class="content-box mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="box-title m-0"><i class="fa-solid fa-diagram-project me-2 text-warning"></i>Projects Management</h4>
            <p class="text-muted m-0" style="font-size:13px;">Manage portfolio projects stored in SQL Server Database</p>
        </div>
        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#addProjectModal" style="background:#f97316; border-color:#f97316; color:#fff; font-weight:700;">
            <i class="fa-solid fa-plus me-1"></i> Add New Project
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Technologies</th>
                    <th>Status</th>
                    <th>Links</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Projects)
                {
                    <tr id="project-row-@p.ProjectID">
                        <td>
                            <img src="/Images/@p.Image" alt="@p.Title" style="width:48px; height:48px; border-radius:8px; object-fit:cover;" onerror="this.src='/Images/Project-bg.jpeg'" />
                        </td>
                        <td>
                            <strong style="color:var(--text-main); display:block;">@p.Title</strong>
                            <small class="text-muted" style="max-width:200px; display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@p.Description</small>
                        </td>
                        <td><span class="badge bg-secondary">@p.Category</span></td>
                        <td><small style="color:#38bdf8;">@p.Technalogy</small></td>
                        <td><span class="badge bg-success">@(p.Status ?? "Published")</span></td>
                        <td>
                            <div class="d-flex gap-2">
                                @if (!string.IsNullOrEmpty(p.LiveDemo))
                                {
                                    <a href="@p.LiveDemo" target="_blank" class="btn btn-sm btn-outline-info" title="Live Demo"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                                }
                                @if (!string.IsNullOrEmpty(p.GitHub))
                                {
                                    <a href="@p.GitHub" target="_blank" class="btn btn-sm btn-outline-light" title="GitHub"><i class="fa-brands fa-github"></i></a>
                                }
                            </div>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteProject(@p.ProjectID)" title="Delete Project">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
