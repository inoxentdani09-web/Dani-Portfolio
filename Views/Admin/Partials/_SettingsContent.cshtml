@model Portfolio.Models.ViewModels.AdminDashboardViewModel

<div class="row g-4">
    <!-- Left: Portfolio Content & Dynamic Copy Settings -->
    <div class="col-12 col-lg-7">
        <div class="content-box">
            <h5 class="box-title mb-3"><i class="fa-solid fa-sliders me-2 text-warning"></i>Website Content Settings</h5>
            
            <form id="portfolioSettingsForm" onsubmit="handleSettingsUpdate(event)">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Site Title</label>
                        <input type="text" name="SiteTitle" class="form-control" value="@Model.Settings.SiteTitle" required />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Tagline</label>
                        <input type="text" name="Tagline" class="form-control" value="@Model.Settings.Tagline" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Hero Main Heading</label>
                        <input type="text" name="HeroHeading" class="form-control" value="@Model.Settings.HeroHeading" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Hero Subheading</label>
                        <input type="text" name="HeroSubheading" class="form-control" value="@Model.Settings.HeroSubheading" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Hero Description</label>
                        <textarea name="HeroDescription" class="form-control" rows="3">@Model.Settings.HeroDescription</textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label">About Heading</label>
                        <input type="text" name="AboutHeading" class="form-control" value="@Model.Settings.AboutHeading" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">About Description</label>
                        <textarea name="AboutDescription" class="form-control" rows="4">@Model.Settings.AboutDescription</textarea>
                    </div>

                    <h6 class="mt-4 mb-2 text-warning"><i class="fa-solid fa-credit-card me-2"></i>Payment Accounts (For Student Fee Transfer)</h6>

                    <div class="col-12 col-md-6">
                        <label class="form-label">JazzCash Number</label>
                        <input type="text" name="JazzCashNumber" class="form-control" value="@Model.Settings.JazzCashNumber" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">JazzCash Account Title</label>
                        <input type="text" name="JazzCashTitle" class="form-control" value="@Model.Settings.JazzCashTitle" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">EasyPaisa Number</label>
                        <input type="text" name="EasyPaisaNumber" class="form-control" value="@Model.Settings.EasyPaisaNumber" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">EasyPaisa Account Title</label>
                        <input type="text" name="EasyPaisaTitle" class="form-control" value="@Model.Settings.EasyPaisaTitle" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Bank Account Number / IBAN</label>
                        <input type="text" name="BankAccountNumber" class="form-control" value="@Model.Settings.BankAccountNumber" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Bank Name & Title</label>
                        <input type="text" name="BankName" class="form-control" value="@Model.Settings.BankName" />
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-warning" style="background:#f97316; border-color:#f97316; color:#fff; font-weight:700;">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Website Settings
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Right: Admin Profile & Credentials -->
    <div class="col-12 col-lg-5">
        <div class="content-box">
            <h5 class="box-title mb-3"><i class="fa-solid fa-user-shield me-2 text-info"></i>Admin Profile & Account</h5>

            <form id="adminProfileForm" onsubmit="handleProfileUpdate(event)">
                @Html.AntiForgeryToken()
                <div class="text-center mb-3">
                    <img src="/Images/@(!string.IsNullOrEmpty(Model.Admin.Avatar) ? Model.Admin.Avatar : "profile.jpg")" alt="Admin" style="width:90px; height:90px; border-radius:50%; border:3px solid #f97316; object-fit:cover;" onerror="this.src='/Images/Developer.png'" />
                    <div class="mt-2">
                        <label class="btn btn-sm btn-outline-secondary">
                            <i class="fa-solid fa-camera me-1"></i> Change Avatar
                            <input type="file" name="avatarFile" accept="image/*" style="display:none;" />
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="Name" class="form-control" value="@Model.Admin.Name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Professional Title</label>
                    <input type="text" name="Title" class="form-control" value="@Model.Admin.Title" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address (Login)</label>
                    <input type="email" name="Email" class="form-control" value="@Model.Admin.Email" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">New Password (Leave blank to keep current)</label>
                    <input type="password" name="Password" class="form-control" placeholder="••••••••" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone</label>
                    <input type="text" name="Phone" class="form-control" value="@Model.Admin.Phone" />
                </div>

                <div class="mb-3">
                    <label class="form-label">GitHub URL</label>
                    <input type="url" name="GithubUrl" class="form-control" value="@Model.Admin.GithubUrl" />
                </div>

                <div class="mb-3">
                    <label class="form-label">LinkedIn URL</label>
                    <input type="url" name="LinkedinUrl" class="form-control" value="@Model.Admin.LinkedinUrl" />
                </div>

                <button type="submit" class="btn btn-primary w-100" style="background:#3b82f6; border-color:#3b82f6; font-weight:700;">
                    <i class="fa-solid fa-user-check me-1"></i> Update Admin Account
                </button>
            </form>
        </div>
    </div>
</div>
