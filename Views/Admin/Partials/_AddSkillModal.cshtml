<div class="modal fade" id="addSkillModal" tabindex="-1" aria-labelledby="addSkillModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:#111726; border:1px solid rgba(255,255,255,0.1); color:#fff; border-radius:16px;">
            <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.08);">
                <h5 class="modal-title" id="addSkillModalLabel"><i class="fa-solid fa-plus-circle me-2 text-primary"></i>Add New Skill to SQL Server</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addSkillForm" onsubmit="handleAddSkill(event)" enctype="multipart/form-data">
                <div class="modal-body" style="padding:24px;">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" style="font-size:13px; font-weight:600;">Skill Name *</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. Entity Framework Core" required style="background:#090d16; border:1px solid #1e293b; color:#fff;" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" style="font-size:13px; font-weight:600;">Category *</label>
                            <select name="CategoryId" class="form-select" required style="background:#090d16; border:1px solid #1e293b; color:#fff;">
                                <option value="1">1 - Frontend</option>
                                <option value="2">2 - Backend</option>
                                <option value="3">3 - Database</option>
                                <option value="4">4 - Tools & Desktop</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" style="font-size:13px; font-weight:600;">Proficiency (%) *</label>
                            <input type="number" name="Percentage" class="form-control" min="10" max="100" value="90" required style="background:#090d16; border:1px solid #1e293b; color:#fff;" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" style="font-size:13px; font-weight:600;">Short Description *</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="e.g. ORM mapping, Linq queries, migrations and relationship modeling..." required style="background:#090d16; border:1px solid #1e293b; color:#fff;"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label" style="font-size:13px; font-weight:600;">Icon Image (e.g. PNG / SVG)</label>
                            <input type="file" name="iconFile" class="form-control" accept="image/*" style="background:#090d16; border:1px solid #1e293b; color:#fff;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.08);">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background:#3b82f6; border-color:#3b82f6; color:#fff; font-weight:700;">Save Skill</button>
                </div>
            </form>
        </div>
    </div>
</div>
