@using System.Text.Json

<div class="card-box">

  
    <!-- Header -->
    <div class="panel-header">
        <div>
            <h2>Client Messages & Inquiries</h2>
            <p>Read contact submissions from the website, view sender details, and respond directly</p>
        </div>

        <div class="d-flex gap-2">
            @{
                var unreadCount = 0;

                foreach (var message in Model.Messages)
                {
                    if (!message.IsRead)
                    {
                        unreadCount++;
                    }
                }

                var totalMessages = Model.Messages.Count;
                var readCount = totalMessages - unreadCount;
            }

            @if (unreadCount > 0)
            {
                <span class="status-badge status-danger" style="font-size:12px; padding:6px 12px;">
                    <i class="fa-solid fa-bell me-1"></i> @unreadCount New Inquiries
                </span>
            }

            <a href="/Admin/ExportMessages" class="btn-secondary-action">
                <i class="fa-solid fa-file-excel"></i> Export Excel
            </a>
        </div>
    </div>


    <!-- Toolbar -->
    <div class="table-toolbar">

        <div class="search-field-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   id="messageSearchInput"
                   placeholder="Search sender, email, subject, text..."
                   onkeyup="filterMessagesTable()" />
        </div>


        <div class="d-flex gap-1" id="messageFilterTabs">

            <button type="button"
                    class="btn btn-sm btn-outline-secondary active"
                    onclick="setMessageFilter('all', this)"
                    style="font-size:11.5px; padding:4px 10px;">
                All (@totalMessages)
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    onclick="setMessageFilter('unread', this)"
                    style="font-size:11.5px; padding:4px 10px;">
                Unread (@unreadCount)
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-success"
                    onclick="setMessageFilter('read', this)"
                    style="font-size:11.5px; padding:4px 10px;">
                Read (@readCount)
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-warning"
                    onclick="setMessageFilter('starred', this)"
                    style="font-size:11.5px; padding:4px 10px;">
                Starred (0)
            </button>

        </div>
    </div>


    <!-- Data Table -->
    <div class="table-responsive">

        <table class="table-custom" id="messagesMainTable">

            <thead>
                <tr>

                    <th style="width:34px;">
                        <i class="fa-solid fa-star"></i>
                    </th>

                    <th>Sender Name</th>

                    <th>Email & Phone</th>

                    <th>Subject</th>

                    <th>Status</th>

                    <th>Date Received</th>

                    <th style="text-align:right;">
                        Actions
                    </th>

                </tr>
            </thead>


            <tbody>

                @if (Model.Messages == null || Model.Messages.Count == 0)
                {
                    <tr>
                        <td colspan="7"
                            style="text-align:center; padding:30px; color:var(--text-muted);">

                            <i class="fa-regular fa-envelope mb-2"
                               style="font-size:24px; display:block; opacity:0.5;">
                            </i>

                            No messages received yet. Inquiries submitted via the Contact form will appear here.

                        </td>
                    </tr>
                }
                else
                {
                    foreach (var msg in Model.Messages)
                    {
                        var status = msg.IsRead ? "Read" : "Unread";

                        var searchText =
                            $"{msg.Name} {msg.Email} {msg.Phone} {msg.Subject} {msg.MessageText}"
                            .ToLower();

                        <tr class="message-table-row @(msg.IsRead ? "" : "table-active")"
                            id="msg-row-@msg.MessageID"
                            data-status="@status.ToLower()"
                            data-starred="false"
                            data-search="@searchText">

                            <!-- Star -->
                            <td>

                                <button type="button"
                                        onclick="toggleStar(@msg.MessageID, this)"
                                        style="background:transparent; border:none; color:var(--text-muted); cursor:pointer; font-size:14px;">

                                    <i class="fa-regular fa-star"></i>

                                </button>

                            </td>


                            <!-- Sender -->
                            <td>

                                <strong style="color:var(--text-main); font-size:13px;">
                                    @msg.Name
                                </strong>

                                @if (!msg.IsRead)
                                {
                                    <span class="status-badge status-danger ms-1"
                                          style="font-size:9.5px; padding:1px 5px;">
                                        New
                                    </span>
                                }

                            </td>


                            <!-- Email / Phone -->
                            <td>

                                <div style="color:var(--status-info); font-size:12px;">
                                    @msg.Email
                                </div>

                                @if (!string.IsNullOrWhiteSpace(msg.Phone))
                                {
                                    <small style="color:var(--text-muted); font-size:10.5px;">

                                        <i class="fa-solid fa-phone me-1"></i>

                                        @msg.Phone

                                    </small>
                                }

                            </td>


                            <!-- Subject -->
                            <td>

                                <span style="color:var(--text-soft); font-weight:600; font-size:12.5px;">
                                    @msg.Subject
                                </span>

                            </td>


                            <!-- Status -->
                            <td>

                                @if (!msg.IsRead)
                                {
                                    <span class="status-badge status-danger">
                                        Unread
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">
                                        Read
                                    </span>
                                }

                            </td>


                            <!-- Date -->
                            <td style="color:var(--text-muted); font-size:11.5px;">

                                @msg.SentAt.ToLocalTime().ToString("MMM d, yyyy")

                            </td>


                            <!-- Actions -->
                            <td style="text-align:right;">

                                <div class="action-buttons-group">

                                    <!-- View -->
                                    <button type="button"
                                            class="btn-icon-action view-btn"
                                            onclick="viewMessageDetails(@msg.MessageID)"
                                            title="Read Message">

                                        <i class="fa-solid fa-eye"></i>

                                    </button>


                                    <!-- Reply -->
                                    <button type="button"
                                            class="btn-icon-action edit-btn"
                                            onclick="openReplyModal(@msg.MessageID, '@Html.Raw(JsonSerializer.Serialize(msg.Name).Trim('"'))', '@Html.Raw(JsonSerializer.Serialize(msg.Email).Trim('"'))')"
                                            title="Reply via Email">

                                        <i class="fa-solid fa-reply"></i>

                                    </button>


                                    <!-- Delete -->
                                    <button type="button"
                                            class="btn-icon-action delete-btn"
                                            onclick="deleteMessageRow(@msg.MessageID)"
                                            title="Delete Message">

                                        <i class="fa-solid fa-trash"></i>

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>
   

</div>

<!-- View Message Modal -->

<div class="custom-admin-modal-overlay" id="viewMessageModal">

   
    <div class="custom-modal-card" style="max-width:550px;">

        <div class="custom-modal-header">

            <div>

                <span>CLIENT INQUIRY</span>

                <h2 id="viewMsgSubject">
                    Message Subject
                </h2>

            </div>


            <button type="button"
                    class="custom-modal-close"
                    onclick="closeViewMessageModal()">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <div class="custom-modal-body">

            <div style="background:var(--bg-input); border-radius:8px; border:1px solid var(--border-color); padding:12px; margin-bottom:14px;">

                <div class="d-flex justify-content-between mb-1">

                    <strong style="color:var(--text-main); font-size:13px;"
                            id="viewMsgSender">
                        Sender Name
                    </strong>

                    <span style="color:var(--text-muted); font-size:11px;"
                          id="viewMsgDate">
                        Date
                    </span>

                </div>


                <div style="color:var(--status-info); font-size:12px;"
                     id="viewMsgEmail">
                    sender@example.com
                </div>


                <div style="color:var(--text-muted); font-size:11.5px;"
                     id="viewMsgPhone">
                </div>

            </div>


            <div>

                <label style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:6px; display:block;">
                    Message Body
                </label>

                <div id="viewMsgContent"
                     style="background:var(--bg-input); border:1px solid var(--border-color); border-radius:8px; padding:14px; color:var(--text-soft); font-size:13px; line-height:1.6; white-space:pre-wrap; min-height:100px;">
                </div>

            </div>

        </div>


        <div class="custom-modal-footer">

            <button type="button"
                    class="btn-modal-cancel"
                    onclick="closeViewMessageModal()">

                Close

            </button>


            <button type="button"
                    class="btn-modal-submit"
                    id="viewMsgReplyBtn">

                <i class="fa-solid fa-reply"></i>
                Reply

            </button>

        </div>

    </div>


</div>

<!-- Reply Message Modal -->

<div class="custom-admin-modal-overlay" id="replyMessageModal">

    
    <div class="custom-modal-card" style="max-width:550px;">

        <div class="custom-modal-header">

            <div>

                <span>SEND DIRECT EMAIL REPLY</span>

                <h2>
                    Reply to Client
                </h2>

            </div>


            <button type="button"
                    class="custom-modal-close"
                    onclick="closeReplyModal()">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <form onsubmit="submitReplyMessage(event)">

            <input type="hidden"
                   id="replyMsgId" />


            <div class="custom-modal-body">

                <div class="modal-form-group">

                    <label>
                        Recipient Name
                    </label>

                    <input type="text"
                           id="replyToName"
                           readonly />

                </div>


                <div class="modal-form-group">

                    <label>
                        Recipient Email
                    </label>

                    <input type="email"
                           id="replyToEmail"
                           readonly />

                </div>


                <div class="modal-form-group">

                    <label>
                        Reply Subject
                    </label>

                    <input type="text"
                           id="replySubject"
                           placeholder="Re: Your inquiry"
                           required />

                </div>


                <div class="modal-form-group">

                    <label>
                        Reply Body
                    </label>

                    <textarea id="replyContent"
                              rows="4"
                              placeholder="Type your response here..."
                              required></textarea>

                </div>

            </div>


            <div class="custom-modal-footer">

                <button type="button"
                        class="btn-modal-cancel"
                        onclick="closeReplyModal()">

                    Cancel

                </button>


                <button type="submit"
                        class="btn-modal-submit">

                    <i class="fa-solid fa-paper-plane"></i>
                    Send Reply

                </button>

            </div>

        </form>

    </div>


</div>

<script>

    let currentActiveFilter = 'all';


    function setMessageFilter(filterType, btn) {

        currentActiveFilter = filterType;

        document
            .querySelectorAll('#messageFilterTabs button')
            .forEach(b => b.classList.remove('active'));

        if (btn) {
            btn.classList.add('active');
        }

        filterMessagesTable();

    }


    function filterMessagesTable() {

        const search =
            (document.getElementById('messageSearchInput')?.value || '')
                .toLowerCase()
                .trim();


        const rows =
            document.querySelectorAll('.message-table-row');


        rows.forEach(row => {

            const rowSearch =
                row.getAttribute('data-search') || '';

            const rowStatus =
                row.getAttribute('data-status') || '';

            const rowStarred =
                row.getAttribute('data-starred') === 'true';


            const matchSearch =
                !search || rowSearch.includes(search);


            let matchFilter = true;


            if (currentActiveFilter === 'unread') {

                matchFilter =
                    rowStatus === 'unread';

            }
            else if (currentActiveFilter === 'read') {

                matchFilter =
                    rowStatus === 'read';

            }
            else if (currentActiveFilter === 'starred') {

                matchFilter =
                    rowStarred;

            }


            row.style.display =
                matchSearch && matchFilter ? '' : 'none';

        });

    }


    async function viewMessageDetails(id) {

        try {

            const res =
                await fetch(`/Admin/GetMessage?id=${id}`);


            if (!res.ok) {
                throw new Error('Unable to load message');
            }


            const msg =
                await res.json();


            document.getElementById('viewMsgSubject').innerText =
                msg.subject || '';


            document.getElementById('viewMsgSender').innerText =
                msg.name || '';


            document.getElementById('viewMsgEmail').innerText =
                msg.email || '';


            document.getElementById('viewMsgPhone').innerText =
                msg.phone
                    ? ('Phone: ' + msg.phone)
                    : '';


            document.getElementById('viewMsgDate').innerText =
                msg.sentAt
                    ? new Date(msg.sentAt).toLocaleString()
                    : '';


            document.getElementById('viewMsgContent').innerText =
                msg.messageText || '';


            document.getElementById('viewMsgReplyBtn').onclick =
                () => {

                    closeViewMessageModal();

                    openReplyModal(
                        msg.messageID,
                        msg.name,
                        msg.email
                    );

                };


            const modal =
                document.getElementById('viewMessageModal');


            if (modal) {
                modal.classList.add('show');
            }


            const row =
                document.getElementById(`msg-row-${id}`);


            if (row) {

                row.setAttribute(
                    'data-status',
                    'read'
                );


                const badge =
                    row.querySelector('.status-badge');


                if (badge) {

                    badge.className =
                        'status-badge status-active';

                    badge.innerText =
                        'Read';

                }

            }


            await fetch('/Admin/MarkMessageAsRead', {

                method: 'POST',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify({
                    id: id
                })

            });

        }
        catch (e) {

            alert(
                'Failed to load message: ' +
                e.message
            );

        }

    }


    function closeViewMessageModal() {

        const modal =
            document.getElementById('viewMessageModal');


        if (modal) {
            modal.classList.remove('show');
        }

    }


    function openReplyModal(id, name, email) {

        document.getElementById('replyMsgId').value =
            id;


        document.getElementById('replyToName').value =
            name;


        document.getElementById('replyToEmail').value =
            email;


        document.getElementById('replySubject').value =
            `Re: Inquiry from ${name}`;


        document.getElementById('replyContent').value =
            '';


        const modal =
            document.getElementById('replyMessageModal');


        if (modal) {
            modal.classList.add('show');
        }

    }


    function closeReplyModal() {

        const modal =
            document.getElementById('replyMessageModal');


        if (modal) {
            modal.classList.remove('show');
        }

    }


    async function submitReplyMessage(e) {

        e.preventDefault();


        const id =
            document.getElementById('replyMsgId').value;


        const toEmail =
            document.getElementById('replyToEmail').value;


        const subject =
            document.getElementById('replySubject').value;


        const message =
            document.getElementById('replyContent').value;


        try {

            const res =
                await fetch('/Admin/ReplyMessage', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify({

                        id: id,

                        toEmail: toEmail,

                        subject: subject,

                        message: message

                    })

                });


            const result =
                await res.json();


            if (result.success) {

                alert(
                    'Reply sent successfully!'
                );

                closeReplyModal();

                window.location.reload();

            }
            else {

                alert(
                    result.message ||
                    'Failed to send reply.'
                );

            }

        }
        catch (err) {

            alert(
                'Failed to send reply: ' +
                err.message
            );

        }

    }


    async function toggleStar(id, btn) {

        try {

            const res =
                await fetch('/Admin/ToggleStarMessage', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify({
                        id: id
                    })

                });


            const result =
                await res.json();


            if (result.success) {

                const isStarred =
                    result.isStarred;


                const icon =
                    btn.querySelector('i');


                if (isStarred) {

                    btn.style.color =
                        '#eab308';

                    icon.className =
                        'fa-solid fa-star';

                }
                else {

                    btn.style.color =
                        'var(--text-muted)';

                    icon.className =
                        'fa-regular fa-star';

                }


                const row =
                    document.getElementById(
                        `msg-row-${id}`
                    );


                if (row) {

                    row.setAttribute(
                        'data-starred',
                        isStarred
                            ? 'true'
                            : 'false'
                    );

                }

            }

        }
        catch (e) {

            console.error(
                'Toggle star error:',
                e
            );

        }

    }


    async function deleteMessageRow(id) {

        if (!confirm(
            'Are you sure you want to delete this message?'
        )) {
            return;
        }


        try {

            const res =
                await fetch('/Admin/DeleteMessage', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify({
                        id: id
                    })

                });


            const result =
                await res.json();


            if (result.success) {

                window.location.reload();

            }
            else {

                alert(
                    result.message ||
                    'Failed to delete message.'
                );

            }

        }
        catch (e) {

            alert(
                'Failed to delete message: ' +
                e.message
            );

        }

    }

</script>
