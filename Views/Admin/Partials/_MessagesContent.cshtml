@model Portfolio.Models.ViewModels.AdminDashboardViewModel

<div class="content-box mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="box-title m-0"><i class="fa-solid fa-envelope me-2 text-danger"></i>Client Inquiries</h4>
            <p class="text-muted m-0" style="font-size:13px;">Manage client inquiries sent via the frontend contact form into SQL Server</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Sender Name</th>
                    <th>Email / Phone</th>
                    <th>Subject</th>
                    <th>Message Details</th>
                    <th>Received At</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Messages.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No inquiries received yet.</td>
                    </tr>
                }
                @foreach (var m in Model.Messages)
                {
                    <tr id="message-row-@m.MessageID" style="@(!m.IsRead ? "background: rgba(249,115,22,0.05);" : "")">
                        <td><strong style="color:var(--text-main);">@m.Name</strong></td>
                        <td>
                            <small class="d-block"><a href="mailto:@m.Email" style="color:#38bdf8; text-decoration:none;">@m.Email</a></small>
                            <small class="text-muted">@m.Phone</small>
                        </td>
                        <td><span class="badge bg-secondary">@m.Subject</span></td>
                        <td>
                            <p class="m-0 text-muted" style="max-width:260px; font-size:12.5px; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
                                @m.MessageText
                            </p>
                        </td>
                        <td><small>@m.SentAt.ToString("MMM dd, yyyy HH:mm")</small></td>
                        <td>
                            @if (m.IsRead)
                            {
                                <span class="badge bg-secondary">Read</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">New Unread</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @if (!m.IsRead)
                                {
                                    <button type="button" class="btn btn-outline-success" onclick="markMessageRead(@m.MessageID)" title="Mark as Read">
                                        <i class="fa-solid fa-check"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-outline-danger" onclick="deleteMessage(@m.MessageID)" title="Delete Message">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
