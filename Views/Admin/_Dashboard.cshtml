@{
    Layout = null;
}
@model List<DaniPortfolio.Models.Projects>;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard - Daniyal</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-" crossorigin="anonymous">
    <link rel="stylesheet" href="@(Url.Content("~/css/dashboard.css"))" />
    <link rel="stylesheet" href="~/css/Admin-Project.css" />
    <link rel="stylesheet" href="~/css/AdminSkills.css" />
    <link rel="stylesheet" href="~/css/AdminCourse.css" />
    <link rel="stylesheet" href="~/css/Admin_Message.css" />
    <link rel="stylesheet" href="~/css/AddProjectModel.css" asp-append-version="true" />

</head>
<body class="dashboard-bg">
    <div class="dashboard-root">
        <aside class="sidebar">
            <div class="sidebar-top">
                <div class="brand">
                    <div class="brand-logo">&lt;/&gt;</div>
                    <div class="brand-text">Daniyal</div>
                </div>

                <div class="profile d-flex align-items-center">
                    <img src="/images/profile.jpg" alt="Admin" class="avatar" />
                    <div class="profile-info">
                        <div class="name">Daniyal Admin</div>
                        <div class="email">admin@gmail.com</div>
                        <div class="status online text-success">Online</div>
                    </div>
                </div>
            </div>
            <div>
                <nav class="nav-menu">
                    <ul>
                        <li class="active">
                            <a href="#" id="dashboardLink">
                                <i class="fa-solid fa-house"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>

                        <li>
                            <a href="#" id="projectsLink">
                                <i class="fa-solid fa-folder"></i>
                                <span>Projects</span>
                            </a>
                        </li>

                        <li>
                            <a href="#" id="skillLink">

                                <i class="fa-solid fa-code"></i>
                                <span>Skills</span>
                            </a>
                        </li>

                        <li>
                            <a href="courseLink" id="courseLink">
                                <i class="fa-solid fa-book"></i>
                                <span>Courses</span>
                            </a>
                        </li>
                        <li>
                            <a href="messagesLink" id="messagesLink">
                                <i class="fa-regular fa-envelope"></i>
                                <span>Messages</span>
                            </a>
                        </li>
                        <li>
                            <a href="#" id="settingLink">
                                <i class="fa-solid fa-gear"></i>
                                <span>Settings</span>
                            </a>
                        </li>


                    </ul>
                </nav>
            </div>

            <div class="sidebar-bottom">
                <button class="btn-logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
                <div class="copyright">
                    © 2025 Daniyal Developer. All rights reserved.
                </div>

            </div>
        </aside>

        <div class="main">
            <header class="topbar d-flex align-items-center justify-content-between">
                <div class="left-controls d-flex align-items-center">
                    <button class="btn btn-ghost me-3" id="sidebarToggle"><i class="fa-solid fa-bars"></i></button>
                    <div>
                        <h4 class="mb-0">Dashboard</h4>
                        <small class=" top-des">Welcome back, Daniyal Admin! 👋</small>
                    </div>
                </div>

                <div class="right-controls d-flex align-items-center">
                    <button id="themeToggle" class="theme-btn">
                        <i class="fa-solid fa-sun"></i>
                    </button>
                    <button class="btn-notify position-relative me-3"><i class="fa-regular fa-bell"></i><span class="badge">4</span></button>
                    <div class="dropdown">
                        <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <img src="/images/profile.jpg" class="avatar-sm" alt="profile" />
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><a class="dropdown-item" href="#">Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </header>
            <div id="main-content">

                <div class="container-fluid content py-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="stats-grid">
                                <div class="stat card-sm">
                                    <div class="orange"><i class="fa-solid fa-folder-open"></i></div>
                                    <div class="stat-body">
                                        <div class="stat-value">@ViewBag.ProjectsCount</div>
                                        <div class="stat-label">Total Projects</div>
                                    </div>
                                </div>
                                <div class="stat card-sm">
                                    <div class="stat-icon"><i class="fa-solid fa-code"></i></div>
                                    <div class="stat-body">
                                        <div class="stat-value">@ViewBag.SkillsCount</div>
                                        <div class="stat-label">Total Skills</div>
                                    </div>
                                </div>
                                <div class="stat card-sm">
                                    <div class="green"><i class="fa-solid fa-book-open"></i></div>
                                    <div class="stat-body">
                                        <div class="stat-value">@ViewBag.LearnCount</div>
                                        <div class="stat-label">Total Courses</div>
                                    </div>
                                </div>
                                <div class="stat card-sm">
                                    <div class="blue"><i class="fa-regular fa-envelope"></i></div>
                                    <div class="stat-body">
                                        <div class="stat-value">24</div>
                                        <div class="stat-label">Total Messages</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="card panel">
                                <div class="panel-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Recent Projects</h5>
                                    <a href="#" class="small link">View All →</a>
                                </div>
                                <div class="panel-body">
                                    <ul class="list-unstyled recent-projects">

                                        @foreach (var item in Model)
                                        {
                                            <li class="proj-item d-flex align-items-center">
                                                <div class="thumb">
                                                    <img src="/Images/@item.Image" />
                                                </div>

                                                <div class="proj-info flex-grow-1">
                                                    <div class="title">@item.Title</div>

                                                    <div class="meta">
                                                        @item.category • @item.CreatedDate.ToString("MMM dd, yyyy")
                                                    </div>
                                                </div>

                                                <div class="status ">
                                                    @item.Status
                                                </div>
                                            </li>
                                        }

                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="card panel">
                                <div class="panel-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Recent Messages</h5>
                                    <a href="#" class="small link">View All →</a>
                                </div>
                                <div class="panel-body">
                                    <ul class="list-unstyled recent-messages">
                                        <li class="msg-item d-flex align-items-center">
                                            <div class="avatar-circle bg-primary">A</div>
                                            <div class="msg-content flex-grow-1">
                                                <div class="name">Ahmed Raza <span class="time text-muted">2m ago</span></div>
                                                <div class="meta">I'm interested in working with you...</div>
                                            </div>
                                        </li>
                                        <li class="msg-item d-flex align-items-center">
                                            <div class="avatar-circle bg-success">S</div>
                                            <div class="msg-content flex-grow-1">
                                                <div class="name">Sarah Khan <span class="time text-muted">1h ago</span></div>
                                                <div class="meta">Great work on your portfolio!..</div>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-8">
                            <div class="card panel">
                                <div class="panel-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Projects Overview</h5>
                                    <select class="form-select form-select-sm w-auto">
                                        <option>Last 6 Months</option>
                                    </select>
                                </div>
                                <div class="panel-body">
                                    <canvas id="projectsChart" height="160"></canvas>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card panel quick-actions">
                                <h5 class="mb-3">Quick Actions</h5>
                                <div class="d-grid gap-2">
                                    <button class="btn action btn-orange" onclick="openProjectModal()"><i class="fa-solid fa-plus"></i> Add New Project</button>
                                    <button class="btn action btn-violet"><i class="fa-solid fa-code"></i> Add New Skill</button>
                                    <button class="btn action btn-green"><i class="fa-solid fa-book-open"></i> Add New Course</button>
                                    <button class="btn action btn-blue"><i class="fa-regular fa-envelope"></i> View Messages</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_AddProjectModel", new DaniPortfolio.ViewModals.ProjectsViewModal())
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="@(Url.Content("~/js/dashboard.js"))"></script>
</body>
</html>
