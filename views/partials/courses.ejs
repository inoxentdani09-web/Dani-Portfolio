<section class="courses-section" id="courses">
    <div class="courses-container">
        <!-- Section Header -->
        <div class="section-heading animate">
            <span class="section-label">LEARNING ACADEMY & COURSES</span>
            <h2>Master <span>Full-Stack Development</span></h2>
            <p>Study foundational web technologies for free, or enroll in premium industry-grade .NET, SQL Server, and full-stack engineering masterclasses.</p>
        </div>

        <!-- Filter Tabs -->
        <div class="courses-filter-tabs">
            <button class="course-filter-btn active" data-filter="all" onclick="filterCourses('all', this)">
                <i class="fa-solid fa-layer-group"></i> All Courses (<span id="totalCoursesCount"><%= (courses || []).length %></span>)
            </button>
            <button class="course-filter-btn free-tab" data-filter="free" onclick="filterCourses('free', this)">
                <i class="fa-solid fa-gift"></i> Free Courses (Learn Free)
            </button>
            <button class="course-filter-btn paid-tab" data-filter="paid" onclick="filterCourses('paid', this)">
                <i class="fa-solid fa-crown"></i> Premium Paid Courses
            </button>
            <button class="course-filter-btn" data-filter="backend" onclick="filterCourses('backend', this)">
                <i class="fa-solid fa-server"></i> Backend & .NET
            </button>
            <button class="course-filter-btn" data-filter="frontend" onclick="filterCourses('frontend', this)">
                <i class="fa-brands fa-react"></i> Frontend
            </button>
            <button class="course-filter-btn" data-filter="database" onclick="filterCourses('database', this)">
                <i class="fa-solid fa-database"></i> Database & ORM
            </button>
        </div>

        <!-- Courses Grid -->
        <div class="courses-grid" id="coursesGridContainer">
            <% (courses || []).forEach(function(course) { 
                const isFree = course.priceType === 'free' || String(course.price).toLowerCase() === 'free';
                const catLower = (course.category || '').toLowerCase();
            %>
                <div class="course-card animate" 
                     data-price-type="<%= isFree ? 'free' : 'paid' %>"
                     data-category="<%= catLower %>"
                     id="course-card-<%= course.courseID %>">
                    
                    <div class="course-card-top">
                        <div class="course-icon <%= isFree ? 'icon-free' : 'icon-paid' %>">
                            <i class="<%= isFree ? 'fa-solid fa-book-open-reader' : 'fa-solid fa-certificate' %>"></i>
                        </div>
                        
                        <!-- Pricing Badge -->
                        <% if (isFree) { %>
                            <span class="course-pricing-badge free">
                                <i class="fa-solid fa-gift"></i> 100% Free
                            </span>
                        <% } else { %>
                            <div class="course-price-wrap">
                                <span class="original-price"><%= course.originalPrice || 'PKR 6,000' %></span>
                                <span class="course-pricing-badge paid">
                                    <i class="fa-solid fa-crown"></i> <%= course.price || 'PKR 3,500' %>
                                </span>
                            </div>
                        <% } %>
                    </div>

                    <div class="course-content">
                        <div class="course-meta-top">
                            <span class="course-category-tag"><%= course.category %></span>
                            <span class="course-level-tag"><i class="fa-solid fa-signal"></i> <%= course.level %></span>
                        </div>

                        <h3><%= course.courseName %></h3>
                        <p class="course-description"><%= course.description %></p>

                        <div class="course-info">
                            <div class="course-info-item">
                                <i class="fa-solid fa-chalkboard-user"></i>
                                <div>
                                    <span>Instructor</span>
                                    <strong><%= course.instructor %></strong>
                                </div>
                            </div>
                            <div class="course-info-item">
                                <i class="fa-solid fa-clock"></i>
                                <div>
                                    <span>Duration</span>
                                    <strong><%= course.duration %></strong>
                                </div>
                            </div>
                        </div>

                        <div class="course-technology">
                            <span class="tech-label">Technology:</span>
                            <span class="tech-badge"><%= course.technology %></span>
                        </div>

                        <!-- Progress Bar or Rating/Students -->
                        <div class="course-progress">
                            <div class="progress-header">
                                <span><i class="fa-solid fa-star text-warning"></i> <%= course.rating || 4.9 %> (<%= course.enrollments || 450 %> students)</span>
                                <strong><%= isFree ? 'Free Access' : 'Verified Certificate' %></strong>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: <%= course.progress || 100 %>%;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Course Action Footer -->
                    <div class="course-footer">
                        <% if (isFree) { %>
                            <button type="button" class="course-action-btn free-btn" onclick="openFreeCourseReader(<%= course.courseID %>)">
                                <i class="fa-solid fa-book-open"></i> Read & Learn Free
                            </button>
                        <% } else { %>
                            <button type="button" class="course-action-btn paid-btn" onclick="openCourseEnrollmentModal(<%= course.courseID %>)">
                                <i class="fa-solid fa-cart-shopping"></i> Enroll Now &bull; <%= course.price || 'PKR 3,500' %>
                            </button>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- =========================================================
     FREE COURSE READER MODAL (HTML, CSS, JAVASCRIPT)
     ========================================================= -->
<div class="course-modal-overlay" id="freeCourseReaderModal" style="display:none;">
    <div class="course-modal-container reader-modal">
        <div class="course-modal-header">
            <div class="header-left">
                <span class="modal-badge free"><i class="fa-solid fa-book-open"></i> Free Interactive Course Reader</span>
                <h2 id="readerCourseTitle">HTML5 & Modern Web Development</h2>
            </div>
            <button type="button" class="course-modal-close" onclick="closeFreeCourseReader()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="reader-modal-body">
            <!-- Sidebar / Curriculum List -->
            <div class="reader-syllabus">
                <h4><i class="fa-solid fa-list-check me-2"></i>Curriculum Modules</h4>
                <div id="readerCurriculumList" class="curriculum-accordion">
                    <!-- Populated dynamically -->
                </div>
            </div>

            <!-- Content Area / Interactive Lesson -->
            <div class="reader-content-pane">
                <div class="lesson-header">
                    <div>
                        <h3 id="readerLessonTitle">Module 1: Semantic HTML & Page Architecture</h3>
                        <span class="lesson-badge"><i class="fa-solid fa-circle-check text-success"></i> 100% Free Access</span>
                    </div>
                    <div class="reader-download-actions">
                        <button type="button" class="btn-reader-action" onclick="downloadCurrentLessonCode()" title="Download current lesson file">
                            <i class="fa-solid fa-file-arrow-down text-warning"></i> <span>Download Lesson File</span>
                        </button>
                        <button type="button" class="btn-reader-action btn-pack" onclick="downloadFullCourseStarterPack()" title="Download complete course package">
                            <i class="fa-solid fa-download text-success"></i> <span>Download Complete Course Pack</span>
                        </button>
                    </div>
                </div>

                <div class="lesson-description" id="readerLessonExplanation">
                    Learn the core principles of structuring modern websites using clean, semantic tags that boost SEO and accessibility.
                </div>

                <div class="code-editor-box">
                    <div class="code-editor-header">
                        <span><i class="fa-solid fa-code me-2"></i>Live Code Example</span>
                        <div style="display:flex; gap:8px;">
                            <button type="button" class="copy-code-btn" onclick="downloadCurrentLessonCode()">
                                <i class="fa-solid fa-download"></i> Save File
                            </button>
                            <button type="button" class="copy-code-btn" onclick="copyReaderCode()">
                                <i class="fa-regular fa-copy"></i> <span id="copyCodeText">Copy Code</span>
                            </button>
                        </div>
                    </div>
                    <pre class="code-snippet-pre"><code id="readerCodeSnippet" class="language-html"></code></pre>
                </div>

                <div class="interactive-preview-box">
                    <div class="preview-header">
                        <span><i class="fa-solid fa-play me-2"></i>Interactive Output Preview</span>
                        <small style="color:#94a3b8;">Rendered live in browser sandbox</small>
                    </div>
                    <div class="preview-frame" id="readerLivePreview">
                        <!-- Rendered HTML preview -->
                    </div>
                </div>
            </div>
        </div>

        <div class="course-modal-footer">
            <button type="button" class="btn-modal-secondary" onclick="closeFreeCourseReader()">Close Reader</button>
            <a href="https://wa.me/923182315238?text=Hello%20Daniyal,%20I%20have%20a%20question%20about%20your%20free%20web%20development%20course." target="_blank" rel="noopener noreferrer" class="btn-modal-whatsapp" style="background:#25d366; color:#fff; padding:9px 16px; border-radius:8px; font-size:13px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                <i class="fa-brands fa-whatsapp"></i> Ask on WhatsApp
            </a>
            <a href="#Contact" class="btn-modal-primary" onclick="closeFreeCourseReader()">
                <i class="fa-solid fa-comments me-1"></i> Send Contact Message
            </a>
        </div>
    </div>
</div>

<!-- =========================================================
     PAID COURSE ENROLLMENT & CHECKOUT MODAL
     (C#, ASP.NET, SQL Server, Bootstrap, EF Core, React, Fullstack)
     ========================================================= -->
<div class="course-modal-overlay" id="courseEnrollModal" style="display:none;">
    <div class="course-modal-container checkout-modal">
        <div class="course-modal-header">
            <div class="header-left">
                <span class="modal-badge paid"><i class="fa-solid fa-crown"></i> Premium Course Enrollment</span>
                <h2 id="checkoutCourseTitle">C# & Object-Oriented Programming Masterclass</h2>
            </div>
            <button type="button" class="course-modal-close" onclick="closeCourseEnrollModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="checkout-modal-body">
            <!-- Left: Course Benefits & Summary -->
            <div class="checkout-summary-pane">
                <div class="price-banner">
                    <span class="price-lbl">Special Enrolled Price:</span>
                    <div class="price-values">
                        <span class="current-price" id="checkoutCoursePrice">PKR 3,500</span>
                        <span class="discount-price" id="checkoutCourseOriginal">PKR 6,000</span>
                        <span class="discount-pill">SAVE 45%</span>
                    </div>
                </div>

                <div class="benefits-list">
                    <h4><i class="fa-solid fa-shield-halved text-warning me-2"></i>What's Included:</h4>
                    <ul>
                        <li><i class="fa-solid fa-circle-check text-success"></i> Full Lifetime Access to Video Masterclass</li>
                        <li><i class="fa-solid fa-circle-check text-success"></i> Complete Source Code on Private GitHub Repo</li>
                        <li><i class="fa-solid fa-circle-check text-success"></i> Industry-Recognized Completion Certificate</li>
                        <li><i class="fa-solid fa-circle-check text-success"></i> 1-on-1 Direct Q&A Support with Daniyal Khan</li>
                        <li><i class="fa-solid fa-circle-check text-success"></i> 5 Real-World Enterprise Portfolio Projects</li>
                    </ul>
                </div>

                <div class="guarantee-box">
                    <i class="fa-solid fa-award"></i>
                    <div>
                        <strong>100% Satisfaction Guarantee</strong>
                        <p>Join over 1,500+ developers who upgraded their careers.</p>
                    </div>
                </div>
            </div>

            <!-- Right: Checkout & Payment Form -->
            <div class="checkout-form-pane">
                <form id="enrollmentCheckoutForm" onsubmit="handleCourseCheckout(event)">
                    <input type="hidden" id="checkoutCourseId" value="0" />
                    
                    <h4 style="color:#fff; font-size:15px; margin:0 0 14px;"><i class="fa-solid fa-user-graduate me-2 text-warning"></i>1. Student Information</h4>

                    <div class="form-input-row">
                        <label>Your Full Name *</label>
                        <input type="text" id="studentName" placeholder="e.g. Ali Ahmed" required />
                    </div>

                    <div class="form-input-row">
                        <label>Email Address (For Portal Access Key) *</label>
                        <input type="email" id="studentEmail" placeholder="e.g. ali@gmail.com" required />
                    </div>

                    <div class="form-input-row">
                        <label>WhatsApp / Mobile Number *</label>
                        <input type="tel" id="studentPhone" placeholder="e.g. +92 300 1234567" required />
                    </div>

                    <h4 style="color:#fff; font-size:15px; margin:18px 0 10px;"><i class="fa-solid fa-money-bill-transfer me-2 text-warning"></i>2. Transfer Fee to Daniyal's Account</h4>

                    <!-- Dynamic Account Details Selector -->
                    <div class="payment-methods-grid">
                        <label class="payment-method-card active" onclick="selectPaymentMethodTab('JazzCash')">
                            <input type="radio" name="paymentMethod" value="JazzCash" checked />
                            <div class="pm-info">
                                <strong style="color:#ef4444;"><i class="fa-solid fa-mobile-screen-button me-1"></i> JazzCash</strong>
                                <span><%= (locals.settings && settings.paymentAccounts && settings.paymentAccounts.jazzCashNumber) || '0318-2315238' %></span>
                            </div>
                        </label>
                        <label class="payment-method-card" onclick="selectPaymentMethodTab('EasyPaisa')">
                            <input type="radio" name="paymentMethod" value="EasyPaisa" />
                            <div class="pm-info">
                                <strong style="color:#10b981;"><i class="fa-solid fa-wallet me-1"></i> EasyPaisa</strong>
                                <span><%= (locals.settings && settings.paymentAccounts && settings.paymentAccounts.easyPaisaNumber) || '0318-2315238' %></span>
                            </div>
                        </label>
                        <label class="payment-method-card" onclick="selectPaymentMethodTab('Bank Transfer')">
                            <input type="radio" name="paymentMethod" value="Bank Transfer" />
                            <div class="pm-info">
                                <strong style="color:#38bdf8;"><i class="fa-solid fa-building-columns me-1"></i> Bank / Raast</strong>
                                <span><%= (locals.settings && settings.paymentAccounts && settings.paymentAccounts.bankAccountNumber) || '0102-03182315238' %></span>
                            </div>
                        </label>
                    </div>

                    <!-- Selected Account Number Card with Copy Button -->
                    <div class="account-instruction-card" id="accountInstructionBox" style="background:#0f172a; border:1px solid rgba(249,115,22,0.3); border-radius:10px; padding:14px; margin-bottom:16px;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span style="color:#94a3b8; font-size:12px; font-weight:600;" id="accTypeLabel">JAZZCASH ACCOUNT</span>
                            <button type="button" class="btn btn-sm" style="background:rgba(249,115,22,0.2); color:#f97316; border:none; padding:3px 10px; font-size:12px; border-radius:6px; font-weight:700;" onclick="copyCurrentPaymentNumber()">
                                <i class="fa-regular fa-copy me-1"></i> Copy Number
                            </button>
                        </div>
                        <div style="font-size:18px; font-weight:800; color:#fff; font-family:monospace; letter-spacing:1px;" id="accNumberVal">
                            <%= (locals.settings && settings.paymentAccounts && settings.paymentAccounts.jazzCashNumber) || '0318-2315238' %>
                        </div>
                        <div style="font-size:12px; color:#cbd5e1; margin-top:4px;">
                            Account Title: <strong id="accTitleVal" style="color:#f97316;"><%= (locals.settings && settings.paymentAccounts && settings.paymentAccounts.jazzCashTitle) || 'Daniyal Khan' %></strong>
                        </div>
                    </div>

                    <h4 style="color:#fff; font-size:15px; margin:16px 0 10px;"><i class="fa-solid fa-receipt me-2 text-warning"></i>3. Payment Verification Proof</h4>

                    <div class="form-input-row">
                        <label>Transaction ID / TID (From SMS / Bank App) *</label>
                        <input type="text" id="transactionId" placeholder="e.g. JC-88392104 or Trx ID from receipt" required />
                    </div>

                    <div class="form-input-row">
                        <label>Upload Payment Screenshot Proof (Optional / Recommended)</label>
                        <input type="file" id="screenshotProofFile" accept="image/*" onchange="handleProofScreenshotUpload(this)" style="background:#0b1120; color:#cbd5e1; border:1px dashed #334155; padding:8px; border-radius:8px; width:100%; font-size:13px;" />
                        <input type="hidden" id="screenshotProofDataUrl" value="" />
                        <div id="screenshotPreviewBox" style="display:none; margin-top:8px;">
                            <img id="screenshotPreviewImg" src="" alt="Proof Preview" style="max-height:80px; border-radius:6px; border:1px solid #f97316;" />
                            <small style="color:#10b981; display:block; margin-top:4px;"><i class="fa-solid fa-check"></i> Screenshot attached for Admin verification</small>
                        </div>
                    </div>

                    <div class="checkout-actions mt-3">
                        <button type="submit" class="btn-complete-enroll" id="btnSubmitEnrollment">
                            <i class="fa-solid fa-lock me-2"></i> Submit Application & Enroll
                        </button>
                    </div>
                </form>

                <div id="enrollmentSuccessState" style="display:none; text-align:center; padding:24px 10px;">
                    <div style="width:64px; height:64px; border-radius:50%; background:rgba(16,185,129,0.15); color:#10b981; font-size:30px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:16px;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h3 style="color:#fff; margin-bottom:8px;">Application Submitted!</h3>
                    <p style="color:#94a3b8; font-size:13px; line-height:1.6; margin-bottom:16px;">
                        Thank you for applying for <strong id="successCourseName" style="color:#f97316;"></strong>! Your payment details and transaction proof have been sent to <strong>Daniyal Khan</strong>.
                    </p>
                    <div style="background:#0f172a; border:1px solid rgba(249,115,22,0.3); border-radius:10px; padding:12px; margin-bottom:16px; text-align:left;">
                        <span style="font-size:11px; color:#94a3b8; text-transform:uppercase;">Application Status</span>
                        <div style="font-weight:700; color:#fbbf24; font-size:14px; margin-top:2px;">
                            <i class="fa-solid fa-hourglass-half me-1"></i> Pending Admin Verification
                        </div>
                        <p style="font-size:12px; color:#cbd5e1; margin:6px 0 0;">
                            As soon as Daniyal verifies your TID/screenshot in the admin dashboard, your Access Key will be activated!
                        </p>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <a id="whatsappShareBtn" href="#" target="_blank" class="btn btn-success w-100" style="background:#16a34a; border-color:#16a34a; font-weight:700;">
                            <i class="fa-brands fa-whatsapp me-1"></i> Send Screenshot to Daniyal on WhatsApp
                        </a>
                        <button type="button" class="btn btn-outline-secondary w-100" onclick="closeCourseEnrollModal()" style="border-radius:8px; color:#cbd5e1;">
                            Done
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Student Access Status Modal -->
<div class="course-modal-overlay" id="studentAccessModal" style="display:none;">
    <div class="course-modal-dialog" style="max-width:550px;">
        <div class="course-modal-header">
            <div>
                <span class="modal-badge-label">STUDENT ACCESS PORTAL</span>
                <h2 style="font-size:20px;">Lookup Your Enrolled Courses</h2>
            </div>
            <button type="button" class="course-modal-close" onclick="closeStudentAccessModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div style="padding:20px;">
            <div class="form-input-row mb-3">
                <label>Enter Your Email Address or Transaction ID *</label>
                <div class="d-flex gap-2">
                    <input type="text" id="studentLookupInput" placeholder="e.g. ali@gmail.com or JC-88392104" style="background:#0b1120; color:#fff; border:1px solid #334155; padding:10px 14px; border-radius:8px; flex:1;" />
                    <button type="button" class="btn btn-warning" style="background:#f97316; border-color:#f97316; color:#fff; font-weight:700; border-radius:8px; padding:0 18px;" onclick="checkStudentAccessStatus()">
                        <i class="fa-solid fa-magnifying-glass"></i> Check
                    </button>
                </div>
            </div>
            <div id="studentLookupResult" style="margin-top:16px;"></div>
        </div>
    </div>
</div>
