<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title><%= title || 'Daniyal Portfolio - Full Stack Developer' %></title>
    <meta name="description" content="<%= (locals.settings && settings.heroDescription) || 'Full Stack Developer Portfolio showcasing projects, skills, courses, contact form, and admin management dashboard.' %>" />
    <meta property="og:title" content="<%= title || 'Daniyal Portfolio - Full Stack Developer' %>" />
    <meta property="og:description" content="<%= (locals.settings && settings.heroDescription) || 'Full Stack Developer Portfolio showcasing projects, skills, courses, contact form, and admin management dashboard.' %>" />
    <meta property="og:image" content="/Images/profile.jpg" />
    <meta name="theme-color" content="#f97316" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

    <!-- CSS Assets -->
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/Navbar.css" />
    <link rel="stylesheet" href="/css/Animation.css" />
    <link rel="stylesheet" href="/css/Hero.css" />
    <link rel="stylesheet" href="/css/About.css" />
    <link rel="stylesheet" href="/css/Skills.css" />
    <link rel="stylesheet" href="/css/Project.css" />
    <link rel="stylesheet" href="/css/Courses.css" />
    <link rel="stylesheet" href="/css/Contact.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    
    <style>
        /* Responsive Polish & Global Smooth Behaviors */
        html {
            scroll-behavior: smooth;
        }
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #0b0f17;
            color: #f8fafc;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }
        ::selection {
            background: #f97316;
            color: #ffffff;
        }
        /* Filter Pills */
        .filter-tabs {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin: 25px auto 35px;
            padding: 0;
            list-style: none;
        }
        .filter-btn {
            background: rgba(255, 255, 255, 0.05);
            color: #94a3b8;
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
        }
        .filter-btn:hover, .filter-btn.active {
            background: #f97316;
            color: #ffffff;
            border-color: #f97316;
            box-shadow: 0 4px 15px rgba(249, 115, 22, 0.35);
        }
        /* Mobile Overlay Backdrop */
        .nav-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 999;
        }
        .nav-backdrop.show {
            display: block;
        }
        @media (max-width: 768px) {
            .hero-content {
                flex-direction: column-reverse;
                text-align: center;
            }
            .hero-btns {
                justify-content: center;
            }
            .About-Content {
                flex-direction: column;
            }
            .stats-Section {
                flex-direction: column;
                gap: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="nav-backdrop" id="navBackdrop"></div>

    <main>
        <%- body %>
    </main>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
    <script src="/js/Skill-Animation.js"></script>
</body>
</html>
