<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title><%= activeTitle || 'Admin Dashboard' %> - Daniyal Portfolio</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

    <!-- CSS Assets -->
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/Dashboard.css" />

    <script>
        // Apply saved theme immediately to avoid flash of wrong theme
        (function() {
            const savedTheme = localStorage.getItem('daniyal_admin_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleMobileSidebar()"></div>

    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="sidebar" id="adminSidebar">
            <div>
                <!-- Brand -->
                <div class="sidebar-brand">
                    <a href="/Admin/Dashboard" class="logo-3d-container" style="gap:8px; text-decoration:none;">
                        <span class="logo-3d-badge" style="font-size:12px; padding:3px 7px;">&lt;/&gt;</span>
                        <span class="logo-3d-text" style="font-size:17px;">Daniyal<span class="logo-3d-dot">.</span> <span style="font-size:11px; color:var(--text-muted); font-weight:700; text-transform:uppercase; letter-spacing:1px; margin-left:3px;">CMS</span></span>
                    </a>
                    <button class="d-lg-none" onclick="toggleMobileSidebar()" style="background:transparent; border:none; color:var(--text-muted); font-size:16px; cursor:pointer;">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- Navigation Menu -->
                <div style="padding: 14px 10px;">
                    <span class="sidebar-menu-title">Core Modules</span>
                    <ul class="nav flex-column gap-1" style="list-style:none; padding:0; margin:0;">
                        <li class="nav-item">
                            <a href="/Admin/Dashboard" class="sidebar-link <%= activeTab === 'dashboard' ? 'active' : '' %>" data-section="dashboard">
                                <i class="fa-solid fa-chart-pie"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Projects" class="sidebar-link <%= activeTab === 'projects' ? 'active' : '' %>" data-section="projects">
                                <i class="fa-solid fa-diagram-project"></i>
                                <span>Projects</span>
                                <span class="badge-count" style="background:var(--brand-primary); color:#fff;"><%= stats.projectsCount %></span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Skill" class="sidebar-link <%= activeTab === 'skills' ? 'active' : '' %>" data-section="skill">
                                <i class="fa-solid fa-laptop-code"></i>
                                <span>Technical Skills</span>
                                <span class="badge-count" style="background:#3b82f6; color:#fff;"><%= stats.skillsCount %></span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Course" class="sidebar-link <%= activeTab === 'courses' ? 'active' : '' %>" data-section="course">
                                <i class="fa-solid fa-graduation-cap"></i>
                                <span>Courses & Certs</span>
                                <span class="badge-count" style="background:#10b981; color:#fff;"><%= stats.coursesCount %></span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Enrollments" class="sidebar-link <%= activeTab === 'enrollments' ? 'active' : '' %>" data-section="enrollments">
                                <i class="fa-solid fa-id-card-clip"></i>
                                <span>Enrollments & Access</span>
                                <% if (stats.pendingEnrollmentsCount > 0) { %>
                                    <span class="badge-count" style="background:#f59e0b; color:#0f172a; font-weight:800;"><%= stats.pendingEnrollmentsCount %> New</span>
                                <% } else { %>
                                    <span class="badge-count" style="background:var(--border-color); color:var(--text-soft);"><%= stats.enrollmentsCount || 0 %></span>
                                <% } %>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Message" class="sidebar-link <%= activeTab === 'messages' ? 'active' : '' %>" data-section="message">
                                <i class="fa-solid fa-envelope"></i>
                                <span>Client Inquiries</span>
                                <% if (stats.unreadMessagesCount > 0) { %>
                                    <span class="badge-count" style="background:#ef4444; color:#fff;"><%= stats.unreadMessagesCount %> New</span>
                                <% } else { %>
                                    <span class="badge-count" style="background:var(--border-color); color:var(--text-soft);"><%= stats.messagesCount %></span>
                                <% } %>
                            </a>
                        </li>
                    </ul>

                    <span class="sidebar-menu-title" style="margin-top:14px;">Settings & Portal</span>
                    <ul class="nav flex-column gap-1" style="list-style:none; padding:0; margin:0;">
                        <li class="nav-item">
                            <a href="/Admin/Settings" class="sidebar-link <%= activeTab === 'settings' ? 'active' : '' %>" data-section="settings">
                                <i class="fa-solid fa-sliders"></i>
                                <span>Settings & Accounts</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/" target="_blank" class="sidebar-link" style="color:var(--status-info);">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                <span>View Live Site</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Admin User Footer -->
            <div style="padding: 12px 14px; border-top: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; background: var(--bg-card);">
                <div style="display: flex; align-items: center; gap: 8px; overflow:hidden;">
                    <img src="/Images/<%= (locals.admin && admin.avatar) ? admin.avatar : 'profile.jpg' %>" alt="Admin" class="avatar-img" style="width:34px; height:34px; border-radius:50%; border:2px solid var(--brand-primary); object-fit:cover;" onerror="this.src='/Images/Developer.png'" />
                    <div style="overflow:hidden;">
                        <h6 style="margin: 0; font-size: 12px; font-weight: 700; color: var(--text-main); white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
                            <%= (locals.admin && admin.name) || 'Daniyal Khan' %>
                        </h6>
                        <span style="font-size: 10.5px; color: var(--text-muted);"><%= (locals.admin && admin.email) || 'admin@gmail.com' %></span>
                    </div>
                </div>
                <a href="/Admin/Logout?logged_out=true" onclick="adminLogout(event)" title="Logout" style="color: var(--status-danger); font-size: 13px; padding: 6px 8px; border-radius: 6px; background: var(--status-danger-soft); text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">
                    <i class="fa-solid fa-power-off"></i>
                </a>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="main-wrapper">
            <!-- Topbar Header -->
            <header class="topbar">
                <div style="display:flex; align-items:center; gap:12px;">
                    <button class="d-lg-none" onclick="toggleMobileSidebar()" style="background:transparent; border:none; color:var(--text-soft); font-size:18px; cursor:pointer;">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h4 style="margin:0; font-size:15px; font-weight:700; color:var(--text-main);" id="pageHeadingTitle">
                        <%= activeTitle || 'Admin Dashboard' %>
                    </h4>
                </div>

                <div style="display:flex; align-items:center; gap:12px;">
                    <!-- Theme Mode Toggle Button -->
                    <button type="button" class="theme-toggle-btn" id="themeToggleBtn" onclick="toggleAdminTheme()" title="Toggle Dark / Light Mode">
                        <i class="fa-solid fa-moon" id="themeToggleIcon"></i>
                        <span id="themeToggleText" class="d-none d-sm-inline">Dark</span>
                    </button>

                    <!-- Live Website Link -->
                    <a href="/" target="_blank" class="d-none d-md-inline-flex align-items-center gap-2" style="color:var(--text-soft); font-size:12px; text-decoration:none; padding:6px 10px; border-radius:7px; border:1px solid var(--border-color); background:var(--bg-input);">
                        <i class="fa-solid fa-globe" style="color:var(--brand-primary);"></i>
                        <span>Live Site</span>
                    </a>

                    <!-- Messages Quick Alert -->
                    <a href="/Admin/Message" style="position:relative; color:var(--text-muted); font-size:15px; text-decoration:none; padding:6px 8px;">
                        <i class="fa-solid fa-bell"></i>
                        <% if (stats.unreadMessagesCount > 0) { %>
                            <span style="position:absolute; top:2px; right:4px; width:7px; height:7px; background:#ef4444; border-radius:50%;"></span>
                        <% } %>
                    </a>

                    <!-- Profile Quick Link -->
                    <div style="display:flex; align-items:center; gap:8px; padding-left:8px; border-left:1px solid var(--border-color);">
                        <a href="/Admin/Settings" style="display:flex; align-items:center; gap:6px; text-decoration:none; color:inherit;">
                            <img src="/Images/<%= (locals.admin && admin.avatar) ? admin.avatar : 'profile.jpg' %>" alt="Admin" style="width:28px; height:28px; border-radius:50%; border:1px solid var(--brand-primary); object-fit:cover;" onerror="this.src='/Images/Developer.png'" />
                            <span class="d-none d-lg-inline" style="font-size:12px; font-weight:600; color:var(--text-soft);"><%= (locals.admin && admin.name) || 'Admin' %></span>
                        </a>
                        <a href="/Admin/Logout?logged_out=true" onclick="adminLogout(event)" title="Logout" style="color:var(--status-danger); text-decoration:none; padding:5px 8px; font-size:12px; border-radius:6px; background:var(--status-danger-soft);">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </a>
                    </div>
                </div>
            </header>

            <!-- Dynamic Content Area -->
            <main class="content-area" id="dynamicContentContainer">
                <%- currentContent %>
            </main>
        </div>
    </div>

    <!-- Modals (Add/Edit Project, Skill, Course) -->
    <%- include('partials/add_project_modal') %>
    <%- include('partials/add_skill_modal') %>
    <%- include('partials/add_course_modal') %>

    <!-- Global Scripts -->
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/dashboard.js"></script>
</body>
</html>
