<!-- Top Metrics Row -->
<div class="stats-grid-row">
    <!-- Projects -->
    <div class="stat-box">
        <div class="stat-box-content">
            <span class="stat-box-label">Total Projects</span>
            <div class="stat-box-val"><%= stats.projectsCount %></div>
            <div class="stat-box-meta" style="color:var(--status-success);">
                <i class="fa-solid fa-circle-check"></i> <%= stats.publishedProjectsCount %> Published
            </div>
        </div>
        <div class="stat-box-icon" style="background:var(--brand-primary-soft); color:var(--brand-primary);">
            <i class="fa-solid fa-diagram-project"></i>
        </div>
    </div>

    <!-- Skills -->
    <div class="stat-box">
        <div class="stat-box-content">
            <span class="stat-box-label">Technical Skills</span>
            <div class="stat-box-val"><%= stats.skillsCount %></div>
            <div class="stat-box-meta" style="color:var(--status-info);">
                <i class="fa-solid fa-layer-group"></i> Full Stack Technologies
            </div>
        </div>
        <div class="stat-box-icon" style="background:var(--status-info-soft); color:var(--status-info);">
            <i class="fa-solid fa-laptop-code"></i>
        </div>
    </div>

    <!-- Courses -->
    <div class="stat-box">
        <div class="stat-box-content">
            <span class="stat-box-label">Courses & Certs</span>
            <div class="stat-box-val"><%= stats.coursesCount %></div>
            <div class="stat-box-meta" style="color:var(--status-success);">
                <i class="fa-solid fa-certificate"></i> <%= stats.completedCoursesCount %> Completed
            </div>
        </div>
        <div class="stat-box-icon" style="background:var(--status-success-soft); color:var(--status-success);">
            <i class="fa-solid fa-graduation-cap"></i>
        </div>
    </div>

    <!-- Enrollments -->
    <div class="stat-box">
        <div class="stat-box-content">
            <span class="stat-box-label">Student Enrollments</span>
            <div class="stat-box-val"><%= stats.enrollmentsCount || 0 %></div>
            <% if (stats.pendingEnrollmentsCount > 0) { %>
                <div class="stat-box-meta" style="color:var(--status-warning); font-weight:700;">
                    <i class="fa-solid fa-clock"></i> <%= stats.pendingEnrollmentsCount %> Pending Approval
                </div>
            <% } else { %>
                <div class="stat-box-meta" style="color:var(--status-success);">
                    <i class="fa-solid fa-circle-check"></i> <%= stats.approvedEnrollmentsCount || 0 %> Approved
                </div>
            <% } %>
        </div>
        <div class="stat-box-icon" style="background:var(--status-warning-soft); color:var(--status-warning);">
            <i class="fa-solid fa-id-card-clip"></i>
        </div>
    </div>

    <!-- Messages -->
    <div class="stat-box">
        <div class="stat-box-content">
            <span class="stat-box-label">Client Messages</span>
            <div class="stat-box-val"><%= stats.messagesCount %></div>
            <% if (stats.unreadMessagesCount > 0) { %>
                <div class="stat-box-meta" style="color:var(--status-danger); font-weight:700;">
                    <i class="fa-solid fa-bell"></i> <%= stats.unreadMessagesCount %> Unread Inquiries
                </div>
            <% } else { %>
                <div class="stat-box-meta" style="color:var(--text-muted);">
                    <i class="fa-solid fa-check-double"></i> All Inquiries Handled
                </div>
            <% } %>
        </div>
        <div class="stat-box-icon" style="background:var(--status-danger-soft); color:var(--status-danger);">
            <i class="fa-solid fa-envelope"></i>
        </div>
    </div>
</div>

<!-- Charts & Quick Actions Row -->
<div class="row g-3 mb-3">
    <!-- Chart: Tech Stack Proficiency & Distribution -->
    <div class="col-lg-8">
        <div class="card-box" style="height:100%;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 style="font-size:14px; font-weight:700; margin:0; color:var(--text-main);">
                        <i class="fa-solid fa-chart-column me-2" style="color:var(--brand-primary);"></i> Technical Skills & Mastery Matrix (%)
                    </h2>
                    <p style="font-size:11.5px; color:var(--text-muted); margin-top:2px;">Live proficiency rating from database stack</p>
                </div>
                <span class="badge" style="background:var(--bg-input); border:1px solid var(--border-color); color:var(--text-soft); font-size:11px;">SQL Synced</span>
            </div>
            <div style="height: 240px; position:relative;">
                <canvas id="skillsChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Quick Actions Panel -->
    <div class="col-lg-4">
        <div class="card-box" style="height:100%;">
            <h2 style="font-size:14px; font-weight:700; margin-bottom:12px; color:var(--text-main);">
                <i class="fa-solid fa-bolt me-2" style="color:var(--status-warning);"></i> Quick Management
            </h2>
            <div class="d-flex flex-column gap-2">
                <button type="button" class="btn text-start p-2 d-flex align-items-center justify-content-between" onclick="openProjectModal()" style="background:var(--brand-primary-soft); border:1px solid rgba(249,115,22,0.25); color:var(--brand-primary); border-radius:8px; font-size:12.5px; font-weight:600;">
                    <span><i class="fa-solid fa-folder-plus me-2"></i> Add New Project</span>
                    <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
                </button>

                <button type="button" class="btn text-start p-2 d-flex align-items-center justify-content-between" onclick="openSkillModal()" style="background:var(--status-info-soft); border:1px solid rgba(56,189,248,0.25); color:var(--status-info); border-radius:8px; font-size:12.5px; font-weight:600;">
                    <span><i class="fa-solid fa-laptop-code me-2"></i> Add Technical Skill</span>
                    <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
                </button>

                <button type="button" class="btn text-start p-2 d-flex align-items-center justify-content-between" onclick="openCourseModal()" style="background:var(--status-success-soft); border:1px solid rgba(16,185,129,0.25); color:var(--status-success); border-radius:8px; font-size:12.5px; font-weight:600;">
                    <span><i class="fa-solid fa-graduation-cap me-2"></i> Add Course & Cert</span>
                    <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
                </button>

                <a href="/Admin/Enrollments" class="btn text-start p-2 d-flex align-items-center justify-content-between" style="background:var(--status-warning-soft); border:1px solid rgba(245,158,11,0.25); color:var(--status-warning); border-radius:8px; font-size:12.5px; font-weight:600; text-decoration:none;">
                    <span><i class="fa-solid fa-user-check me-2"></i> Verify Student Payments</span>
                    <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
                </a>

                <a href="/Admin/Settings" class="btn text-start p-2 d-flex align-items-center justify-content-between" style="background:var(--bg-input); border:1px solid var(--border-color); color:var(--text-soft); border-radius:8px; font-size:12.5px; font-weight:600; text-decoration:none;">
                    <span><i class="fa-solid fa-sliders me-2"></i> Site Settings & Accounts</span>
                    <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Projects & Recent Inquiries Tables -->
<div class="row g-3">
    <!-- Recent Projects -->
    <div class="col-lg-7">
        <div class="card-box">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 style="font-size:14px; font-weight:700; margin:0; color:var(--text-main);">
                    <i class="fa-solid fa-diagram-project me-2" style="color:var(--brand-primary);"></i> Recent Portfolio Projects
                </h2>
                <a href="/Admin/Projects" class="btn-secondary-action" style="padding:4px 10px; font-size:11.5px;">View All</a>
            </div>

            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th style="text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!projects || projects.length === 0) { %>
                            <tr><td colspan="4" style="text-align:center; padding:20px; color:var(--text-muted);">No projects added yet.</td></tr>
                        <% } else { %>
                            <% projects.slice(0, 5).forEach(function(project) { %>
                                <tr>
                                    <td>
                                        <strong style="color:var(--text-main);"><%= project.title %></strong>
                                        <div style="font-size:11px; color:var(--text-muted);"><%= project.technalogy %></div>
                                    </td>
                                    <td><span class="category-badge"><%= project.category %></span></td>
                                    <td>
                                        <span class="status-badge <%= project.status === 'Published' ? 'status-active' : 'status-inactive' %>">
                                            <%= project.status %>
                                        </span>
                                    </td>
                                    <td style="text-align:right;">
                                        <button type="button" class="btn-icon-action edit-btn" onclick="editProject(<%= project.projectID %>)" title="Edit Project">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Inquiries -->
    <div class="col-lg-5">
        <div class="card-box">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 style="font-size:14px; font-weight:700; margin:0; color:var(--text-main);">
                    <i class="fa-solid fa-envelope-open-text me-2" style="color:var(--status-danger);"></i> Recent Client Messages
                </h2>
                <a href="/Admin/Message" class="btn-secondary-action" style="padding:4px 10px; font-size:11.5px;">View All</a>
            </div>

            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Sender</th>
                            <th>Subject</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!messages || messages.length === 0) { %>
                            <tr><td colspan="3" style="text-align:center; padding:20px; color:var(--text-muted);">No inquiries yet.</td></tr>
                        <% } else { %>
                            <% messages.slice(0, 5).forEach(function(msg) { %>
                                <tr>
                                    <td>
                                        <strong style="color:var(--text-main); font-size:12px;"><%= msg.name %></strong>
                                        <div style="font-size:10.5px; color:var(--text-muted);"><%= msg.email %></div>
                                    </td>
                                    <td>
                                        <span style="font-size:11.5px; color:var(--text-soft); font-weight:500;"><%= (msg.subject || '').substring(0, 22) %><%= (msg.subject && msg.subject.length > 22) ? '...' : '' %></span>
                                    </td>
                                    <td>
                                        <% if (msg.status === 'Unread') { %>
                                            <span class="status-badge status-danger">New</span>
                                        <% } else { %>
                                            <span class="status-badge status-active">Read</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    initDashboardSkillsChart();
});

function initDashboardSkillsChart() {
    const ctx = document.getElementById('skillsChart');
    if (!ctx || !window.Chart) return;

    const skillsData = <%- JSON.stringify(skills || []) %>;
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    
    const labels = skillsData.slice(0, 8).map(s => s.name);
    const data = skillsData.slice(0, 8).map(s => s.proficiency || (s.level === 'Expert' ? 95 : s.level === 'Advanced' ? 88 : s.level === 'Intermediate' ? 75 : 60));

    if (window.skillsChartInstance) {
        window.skillsChartInstance.destroy();
    }

    window.skillsChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels.length ? labels : ['HTML5', 'CSS3', 'JavaScript', 'C# .NET', 'ASP.NET Core', 'SQL Server'],
            datasets: [{
                label: 'Proficiency (%)',
                data: data.length ? data : [95, 92, 88, 90, 90, 85],
                backgroundColor: isLight ? 'rgba(234, 88, 12, 0.85)' : 'rgba(249, 115, 22, 0.8)',
                borderColor: isLight ? '#ea580c' : '#f97316',
                borderWidth: 1,
                borderRadius: 5
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    max: 100,
                    grid: { color: isLight ? 'rgba(0, 0, 0, 0.06)' : 'rgba(255, 255, 255, 0.05)' },
                    ticks: { color: isLight ? '#64748b' : '#94a3b8', font: { size: 11 } }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: isLight ? '#334155' : '#cbd5e1', font: { size: 11 } }
                }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });
}
</script>
