<div class="add-project-modal" id="addProjectModal">
    <div class="Project-modal">
        <!-- Header -->
        <div class="Project-modal-header">
            <div>
                <p>PROJECT MANAGEMENT</p>
                <h2 id="projectModalHeading">Add New Project</h2>
            </div>
            <button class="close-btn" type="button" onclick="closeProjectModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="/Admin/CreateProjects" method="post" enctype="multipart/form-data">
            <input type="hidden" name="ProjectID" id="ProjectID" value="0" />

            <!-- Body -->
            <div class="Project-modal-body">
                <div class="modal-form-group">
                    <label>Project Title *</label>
                    <input name="Title" id="Title" type="text" placeholder="e.g. Modern Full Stack LMS Portal" required />
                </div>

                <div class="modal-form-group">
                    <label>Description *</label>
                    <textarea name="Description" id="Description" rows="3" placeholder="Brief project summary, key features and architectural highlights..." required></textarea>
                </div>

                <div class="modal-form-grid grid-3">
                    <div class="modal-form-group">
                        <label>Category *</label>
                        <select name="Category" id="Category" required>
                            <option value="Portfolio">Portfolio</option>
                            <option value="Dashboard">Dashboard</option>
                            <option value="E-Commerce">E-Commerce</option>
                            <option value="Desktop Application">Desktop Application</option>
                            <option value="Web API & Backend">Web API & Backend</option>
                        </select>
                    </div>

                    <div class="modal-form-group">
                        <label>Primary Tech / Stack *</label>
                        <input name="Technalogy" id="Technalogy" type="text" placeholder="e.g. ASP.NET Core, C#, SQL" required />
                    </div>

                    <div class="modal-form-group">
                        <label>Status *</label>
                        <select name="Status" id="Status" required>
                            <option value="Published">Published</option>
                            <option value="Draft">Draft</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                </div>

                <div class="modal-form-grid">
                    <div class="modal-form-group">
                        <label>GitHub Repository URL</label>
                        <input name="GitHub" id="GitHub" type="url" placeholder="https://github.com/..." />
                    </div>

                    <div class="modal-form-group">
                        <label>Live Demo URL</label>
                        <input name="LiveDemo" id="LiveDemo" type="url" placeholder="https://..." />
                    </div>
                </div>

                <div class="modal-form-group full">
                    <label>Project Cover Image</label>
                    <div style="display:flex; align-items:center; gap:12px; background:var(--bg-input); padding:8px 12px; border-radius:8px; border:1px solid var(--border-color);">
                        <input type="file" name="ImageFile" id="ImageFile" accept="image/*" onchange="previewProjectImage(this)" style="padding:4px !important;" />
                        <img id="ProjectImagePreview" src="" alt="Preview" style="width:48px; height:48px; border-radius:6px; object-fit:cover; display:none; border:1px solid var(--border-color);" />
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="Project-modal-footer">
                <button class="btn-modal-cancel" type="button" onclick="closeProjectModal()">Cancel</button>
                <button class="btn-modal-submit" type="submit">
                    <i class="fa-solid fa-floppy-disk"></i> Save Project
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function previewProjectImage(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById('ProjectImagePreview');
            if (preview) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            }
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
